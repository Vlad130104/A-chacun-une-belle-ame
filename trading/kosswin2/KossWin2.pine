//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  KossWin2
//
//  • Tendance par la structure : BOS (cassure dans le sens) et CHoCH (cassure
//    contre le sens), validés à la clôture.
//  • Liquidité : BSL / SSL (sommets et creux non pris) et EQH / EQL (égaux).
//  • Sweep d'EQH / EQL : la mèche dépasse le niveau égal mais la bougie
//    clôture de l'autre côté → point rouge (les BSL / SSL simples n'en ont pas).
//  • Biais directionnel : sens de la structure (BOS / CHoCH) sur un timeframe
//    supérieur, comparé à la structure locale (panneau).
//  • Zones : Order Block + FVG et Supply / Demand, nés de la jambe qui a cassé
//    la structure. Une zone n'est AFFICHÉE qu'après la prise de son inducement
//    (premier repli interne formé après la cassure).
//  • Doji de CHoCH : doji formés dans le mouvement qui mène au CHoCH (jambe
//    avant la cassure + bougie de cassure), affichés en violet seulement après
//    une première réaction du prix sur leur zone.
//
//  Version TradingView. KossWin2.mq5 (MetaTrader 5) n'intègre pas encore le
//  biais directionnel ni les doji, et affiche toujours Premium / Discount.
// ════════════════════════════════════════════════════════════════════════════
indicator("KossWin2", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1500)

// ─── Paramètres ─────────────────────────────────────────────────────────────
const string G_STR = "Structure"
int    swingLen  = input.int(5, "Force des swings (structure)", minval = 2, maxval = 50, group = G_STR, tooltip = "Nombre de bougies de chaque côté pour valider un sommet / creux de structure. Plus grand = structure plus majeure, moins de BOS / CHoCH.")
int    idmLen    = input.int(2, "Force des swings internes (inducement)", minval = 1, maxval = 10, group = G_STR, tooltip = "Taille des petits replis utilisés comme inducement.")
string brkIn     = input.string("Clôture", "Cassure validée par", options = ["Clôture", "Mèche"], group = G_STR)
int    maxLeg    = input.int(300, "Longueur max d'une jambe (bougies)", minval = 20, maxval = 1000, group = G_STR)
int    maxStruct = input.int(4, "BOS / CHoCH affichés", minval = 0, maxval = 50, group = G_STR)
color  bullCol   = input.color(#089981, "Haussier", inline = "tc", group = G_STR)
color  bearCol   = input.color(#F23645, "Baissier", inline = "tc", group = G_STR)

const string G_ZONE = "Zones (affichées seulement après inducement)"
bool  showOB      = input.bool(true, "Order Block + FVG", inline = "ob", group = G_ZONE)
color obBullCol   = input.color(color.new(#089981, 72), "achat", inline = "ob", group = G_ZONE)
color obBearCol   = input.color(color.new(#F23645, 72), "vente", inline = "ob", group = G_ZONE)
bool  showSD      = input.bool(true, "Demand / Supply", inline = "sd", group = G_ZONE)
color demCol      = input.color(color.new(#2962FF, 78), "demand", inline = "sd", group = G_ZONE)
color supCol      = input.color(color.new(#FF9800, 78), "supply", inline = "sd", group = G_ZONE)
int   obLookback  = input.int(5, "OB : recherche avant l'origine (bougies)", minval = 0, maxval = 20, group = G_ZONE)
float dispMult    = input.float(1.5, "S/D : bougie de départ ≥ x ATR", minval = 0.5, step = 0.1, group = G_ZONE)
int   baseMax     = input.int(3, "S/D : bougies de base max", minval = 1, maxval = 6, group = G_ZONE)
bool  hideOverlap = input.bool(true, "Masquer une S/D qui chevauche un OB+FVG", group = G_ZONE)
int   expiry      = input.int(300, "Attente max de l'inducement (bougies)", minval = 10, maxval = 2000, group = G_ZONE)
int   maxZones    = input.int(4, "Zones affichées max par sens", minval = 1, maxval = 20, group = G_ZONE)
int   extBars     = input.int(15, "Prolonger les zones (bougies)", minval = 0, maxval = 200, group = G_ZONE)
bool  delTouched  = input.bool(false, "Effacer une zone après le 1er contact", group = G_ZONE)
bool  showIdm     = input.bool(true, "Afficher l'inducement pris (IDM)", group = G_ZONE)

const string G_LIQ = "Liquidité et sweeps"
bool  showLiq   = input.bool(true, "Niveaux de liquidité (BSL / SSL / EQH / EQL)", group = G_LIQ)
int   maxLiq    = input.int(3, "Niveaux affichés par côté", minval = 1, maxval = 10, group = G_LIQ)
int   eqLen     = input.int(3, "Force des swings EQH / EQL", minval = 1, maxval = 20, group = G_LIQ, tooltip = "Les sommets / creux égaux se forment surtout sur de petits swings : cette force est indépendante de celle de la structure.")
float eqTol     = input.float(0.1, "Tolérance EQH / EQL (× ATR)", minval = 0.0, maxval = 1.0, step = 0.05, group = G_LIQ, tooltip = "Écart maximal entre deux sommets (ou creux) pour les considérer comme égaux, dans un sens comme dans l'autre.")
color liqCol    = input.color(#787B86, "Couleur des niveaux", group = G_LIQ)
bool   showSweep = input.bool(true, "Point rouge sur les sweeps d'EQH / EQL", group = G_LIQ)
string dotSize   = input.string("Minuscule", "Taille du point", options = ["Minuscule", "Très petit", "Petit"], group = G_LIQ, tooltip = "Minuscule = puce « • » (le plus discret). Très petit / Petit = cercle de TradingView.")
color  sweepCol  = input.color(color.red, "Couleur du point", group = G_LIQ)

const string G_BIAS = "Biais directionnel"
bool   biasAuto   = input.bool(true, "Timeframe du biais automatique", group = G_BIAS, tooltip = "M1–M5 → H1 · M15–M30 → H4 · H1–H4 → D · D → W · au-delà → M.")
string biasTFIn   = input.timeframe("240", "Timeframe du biais (si non automatique)", group = G_BIAS)
bool   biasFilter = input.bool(false, "Zones seulement dans le sens du biais", group = G_BIAS, tooltip = "Désactivé = comportement inchangé : toutes les zones validées par inducement sont affichées.\nActivé = une zone d'achat n'est affichée qu'en biais haussier, une zone de vente qu'en biais baissier.")
bool   showPanel  = input.bool(true, "Panneau biais / structure", group = G_BIAS)

const string G_DOJI = "Doji de CHoCH"
bool  showDoji    = input.bool(true, "Afficher les doji (violet)", group = G_DOJI)
float dojiBodyPct = input.float(10.0, "Doji : corps maximum (% de l'amplitude)", minval = 1.0, maxval = 50.0, step = 1.0, group = G_DOJI)
color dojiCol     = input.color(color.new(#9C27B0, 70), "Couleur des doji", group = G_DOJI)
int   dojiExpiry  = input.int(300, "Attente max de la 1re réaction (bougies)", minval = 10, maxval = 2000, group = G_DOJI)
int   maxDoji     = input.int(6, "Doji affichés max", minval = 1, maxval = 30, group = G_DOJI)

// ─── Types et état ──────────────────────────────────────────────────────────
type Zone
    int   dir                // 1 = achat (OB haussier / demand), -1 = vente
    int   kind               // 0 = OB + FVG, 1 = Supply / Demand
    float top
    float bottom
    int   left
    int   created            // bougie de la cassure qui a créé la zone
    float idm     = na       // niveau d'inducement
    int   idmBar  = na
    bool  active  = false    // true = inducement pris, zone affichée
    bool  touched = false
    box   bx
    line  idmLn
    label idmLb

type Doji
    int   dir                // 1 = CHoCH haussier (zone sous le prix), -1 = baissier
    float top
    float bottom
    int   bar                // bougie du doji
    int   created            // bougie du CHoCH
    bool  touched = false    // le prix est revenu dans la zone
    bool  active  = false    // réaction confirmée → affiché en violet
    box   bx

type Liq
    float price
    int   bar
    bool  isHigh
    bool  isEq = false
    line  ln
    label lb

var array<Zone>  zones    = array.new<Zone>()
var array<Liq>   liqs     = array.new<Liq>()
var array<line>  stLines  = array.new<line>()
var array<label> stLabels = array.new<label>()
var array<Doji>  dojis    = array.new<Doji>()
var map<int, bool> dojiSeen = map.new<int, bool>()

var float  shPrice = na
var int    shBar   = na
var bool   shLive  = false
var float  slPrice = na
var int    slBar   = na
var bool   slLive  = false
var int    trend   = 0
var string lastTag = "—"
var float  eqHiP   = na      // dernier petit sommet candidat à un EQH
var int    eqHiB   = na
var float  eqLoP   = na      // dernier petit creux candidat à un EQL
var int    eqLoB   = na

const int MAX_PENDING      = 40
const int MAX_DOJI_PENDING = 60

// ─── Séries (calculées à chaque bougie) ─────────────────────────────────────
float atr        = ta.atr(14)
float ph         = ta.pivothigh(high, swingLen, swingLen)
float pl         = ta.pivotlow(low, swingLen, swingLen)
float iph        = ta.pivothigh(high, idmLen, idmLen)
float ipl        = ta.pivotlow(low, idmLen, idmLen)
float eph        = ta.pivothigh(high, eqLen, eqLen)
float epl        = ta.pivotlow(low, eqLen, eqLen)
bool  closeBreak = brkIn == "Clôture"

// ─── Fonctions : zones ──────────────────────────────────────────────────────
zoneColor(Zone z) =>
    z.kind == 0 ? (z.dir == 1 ? obBullCol : obBearCol) : (z.dir == 1 ? demCol : supCol)

zoneText(Zone z) =>
    z.kind == 0 ? "OB+FVG" : (z.dir == 1 ? "Demand" : "Supply")

deleteZone(Zone z) =>
    if not na(z.bx)
        z.bx.delete()
    if not na(z.idmLn)
        z.idmLn.delete()
    if not na(z.idmLb)
        z.idmLb.delete()
    true

activateZone(Zone z) =>
    color c = zoneColor(z)
    z.active := true
    z.bx := box.new(z.left, z.top, bar_index + extBars, z.bottom, border_color = color.new(c, 40), border_width = 1, bgcolor = c, text = zoneText(z), text_size = size.tiny, text_color = color.new(c, 0), text_halign = text.align_right, text_valign = text.align_center)
    if showIdm
        z.idmLn := line.new(z.idmBar, z.idm, bar_index, z.idm, color = liqCol, style = line.style_dotted, width = 1)
        z.idmLb := label.new(math.round((z.idmBar + bar_index) / 2), z.idm, "IDM", style = z.dir == 1 ? label.style_label_up : label.style_label_down, color = color(na), textcolor = liqCol, size = size.tiny)
    true

// Garde au plus `maxZones` zones affichées dans un sens (efface les plus anciennes).
enforceCap(int dir) =>
    int n = 0
    for z in zones
        if z.active and z.dir == dir
            n += 1
    while n > maxZones
        int idx = -1
        for i = 0 to zones.size() - 1
            if zones.get(i).active and zones.get(i).dir == dir
                idx := i
                break
        deleteZone(zones.get(idx))
        zones.remove(idx)
        n -= 1
    n

// Garde au plus MAX_PENDING zones en attente d'inducement.
capPending() =>
    int n = 0
    for z in zones
        if not z.active
            n += 1
    while n > MAX_PENDING
        int idx = -1
        for i = 0 to zones.size() - 1
            if not zones.get(i).active
                idx := i
                break
        zones.remove(idx)
        n -= 1
    n

// Crée les zones (en attente) nées de la jambe qui vient de casser la structure.
//   dir : 1 = cassure haussière (zones d'achat), -1 = cassure baissière
//   o   : bar_index de l'origine de la jambe (creux / sommet extrême)
createZones(int dir, int o) =>
    bool  bull  = dir == 1
    int   oOff  = bar_index - o
    float obTop = na
    float obBot = na
    // 1) Order Block + FVG : premier FVG de la jambe, puis dernière bougie
    //    de couleur opposée avant ce déplacement.
    if showOB and oOff >= 2
        int fvgOff = na
        for off = oOff - 1 to 1
            bool gap = bull ? low[off - 1] > high[off + 1] : high[off - 1] < low[off + 1]
            if gap
                fvgOff := off
                break
        if not na(fvgOff)
            int kOff = na
            for off = fvgOff + 1 to oOff + obLookback
                if bull ? close[off] < open[off] : close[off] > open[off]
                    kOff := off
                    break
            if na(kOff)
                kOff := oOff
            obTop := high[kOff]
            obBot := low[kOff]
            zones.push(Zone.new(dir, 0, obTop, obBot, bar_index - kOff, bar_index))
    // 2) Supply / Demand : base (1 à baseMax petites bougies) juste avant une
    //    bougie de départ forte dans le sens de la cassure.
    if showSD
        for off = oOff to 0
            float rng = high[off] - low[off]
            bool  dep = rng > 0 and rng >= dispMult * atr[off] and math.abs(close[off] - open[off]) / rng >= 0.6 and (bull ? close[off] > open[off] : close[off] < open[off])
            if dep
                int   cnt  = 0
                float bTop = na
                float bBot = na
                for m = 1 to baseMax
                    int   b  = off + m
                    float br = high[b] - low[b]
                    if br > 0 and math.abs(close[b] - open[b]) / br <= 0.5
                        cnt  += 1
                        bTop := na(bTop) ? high[b] : math.max(bTop, high[b])
                        bBot := na(bBot) ? low[b] : math.min(bBot, low[b])
                    else
                        break
                if cnt > 0
                    bool overlap = not na(obTop) and bTop >= obBot and bBot <= obTop
                    if not (hideOverlap and overlap)
                        zones.push(Zone.new(dir, 1, bTop, bBot, bar_index - (off + cnt), bar_index))
                    break
    capPending()

// ─── Fonctions : liquidité et structure ─────────────────────────────────────
liqText(Liq q) =>
    q.isEq ? (q.isHigh ? "EQH" : "EQL") : (q.isHigh ? "BSL" : "SSL")

deleteLiq(Liq q) =>
    if not na(q.ln)
        q.ln.delete()
    if not na(q.lb)
        q.lb.delete()
    true

addLiq(float price, int b, bool isHigh) =>
    bool merged = false
    for q in liqs
        if q.isHigh == isHigh and math.abs(q.price - price) <= eqTol * atr
            q.isEq  := true
            q.price := isHigh ? math.max(q.price, price) : math.min(q.price, price)
            merged  := true
            break
    if not merged
        Liq q = Liq.new(price, b, isHigh)
        if showLiq
            q.ln := line.new(b, price, bar_index, price, color = liqCol, style = line.style_dashed, width = 1)
            q.lb := label.new(bar_index, price, liqText(q), style = label.style_label_left, color = color(na), textcolor = liqCol, size = size.tiny)
        liqs.push(q)
        int n = 0
        for x in liqs
            if x.isHigh == isHigh
                n += 1
        if n > maxLiq
            int idx = -1
            for i = 0 to liqs.size() - 1
                if liqs.get(i).isHigh == isHigh
                    idx := i
                    break
            deleteLiq(liqs.get(idx))
            liqs.remove(idx)
    merged

// EQH / EQL : marque un niveau existant proche comme égal, sinon en crée un.
addEqLiq(float price, int b, bool isHigh) =>
    bool found = false
    for q in liqs
        if q.isHigh == isHigh and math.abs(q.price - price) <= eqTol * atr
            q.isEq  := true
            q.price := isHigh ? math.max(q.price, price) : math.min(q.price, price)
            found   := true
            break
    if not found
        addLiq(price, b, isHigh)
        Liq nq = liqs.last()
        nq.isEq := true
    found

drawStruct(int fromBar, float price, string tag, int dir) =>
    if maxStruct > 0
        color c = dir == 1 ? bullCol : bearCol
        stLines.push(line.new(fromBar, price, bar_index, price, color = c, style = line.style_dashed, width = 1))
        stLabels.push(label.new(math.round((fromBar + bar_index) / 2), price, tag, style = dir == 1 ? label.style_label_down : label.style_label_up, color = color(na), textcolor = c, size = size.tiny))
        if stLines.size() > maxStruct
            stLines.shift().delete()
            stLabels.shift().delete()
    true

// ─── Fonctions : biais directionnel ─────────────────────────────────────────
// Même structure (swings + BOS / CHoCH) calculée sur le timeframe du biais.
// Renvoie la bougie précédente clôturée du TF supérieur : aucun repaint.
htfStructure() =>
    var float hP  = na
    var bool  hOn = false
    var float lP  = na
    var bool  lOn = false
    var int   tr  = 0
    var string tg = "—"
    float a = ta.pivothigh(high, swingLen, swingLen)
    float b = ta.pivotlow(low, swingLen, swingLen)
    if not na(a)
        hP  := a
        hOn := true
    if not na(b)
        lP  := b
        lOn := true
    float up = closeBreak ? close : high
    float dn = closeBreak ? close : low
    if hOn and up > hP
        hOn := false
        tg  := tr == -1 ? "CHoCH" : "BOS"
        tr  := 1
    else if lOn and dn < lP
        lOn := false
        tg  := tr == 1 ? "CHoCH" : "BOS"
        tr  := -1
    [tr[1], tg[1]]

tfLabel(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec >= 2592000 ? "MN" : sec >= 604800 ? "W" : sec >= 86400 ? "D" : sec >= 3600 ? "H" + str.tostring(math.round(sec / 3600)) : "M" + str.tostring(math.round(sec / 60))

int    chartSec = timeframe.in_seconds()
string biasTF   = biasAuto ? (chartSec <= 300 ? "60" : chartSec <= 1800 ? "240" : chartSec <= 14400 ? "D" : chartSec <= 86400 ? "W" : "M") : biasTFIn
[biasTrend, biasTag] = request.security(syminfo.tickerid, biasTF, htfStructure(), lookahead = barmerge.lookahead_on)

// ─── Fonctions : doji ───────────────────────────────────────────────────────
isDoji(int off) =>
    float rng = high[off] - low[off]
    rng > 0 and math.abs(close[off] - open[off]) / rng * 100 <= dojiBodyPct

deleteDoji(Doji d) =>
    if not na(d.bx)
        d.bx.delete()
    true

// Doji du mouvement qui mène au CHoCH : de la bougie du swing cassé (début de
// la dernière jambe) jusqu'à la bougie de cassure incluse.
collectDoji(int dir, int fromBar) =>
    int len = bar_index - fromBar
    for k = len to 0
        int b = bar_index - k
        if isDoji(k) and not dojiSeen.contains(b)
            dojiSeen.put(b, true)
            dojis.push(Doji.new(dir, high[k], low[k], b, bar_index))
    // Limite des doji en attente de réaction
    int n = 0
    for d in dojis
        if not d.active
            n += 1
    while n > MAX_DOJI_PENDING
        int idx = -1
        for i = 0 to dojis.size() - 1
            if not dojis.get(i).active
                idx := i
                break
        dojis.remove(idx)
        n -= 1
    n

// ─── Moteur (uniquement sur bougie clôturée : aucun repaint) ────────────────
bool sweepHi  = false
bool sweepLo  = false
int  newZones = 0
int  newDoji  = 0

if barstate.isconfirmed
    // B) Liquidité : prise (clôture au-delà) ou sweep d'EQH / EQL
    //    (mèche au-delà, clôture en deçà)
    if liqs.size() > 0
        for i = liqs.size() - 1 to 0
            Liq  q   = liqs.get(i)
            bool hit = q.isHigh ? high > q.price : low < q.price
            if hit
                if q.isEq and q.isHigh and close < q.price
                    sweepHi := true
                if q.isEq and not q.isHigh and close > q.price
                    sweepLo := true
                deleteLiq(q)
                liqs.remove(i)

    // C) Vie des zones : invalidation, inducement pris, contact
    if zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z       = zones.get(i)
            bool bull    = z.dir == 1
            bool invalid = bull ? close < z.bottom : close > z.top
            bool inZone  = bull ? low <= z.top : high >= z.bottom
            bool kill    = false
            bool justOn  = false
            if invalid
                kill := true
            else
                if not z.active
                    if bar_index - z.created > expiry
                        kill := true
                    else if na(z.idm)
                        // Le prix revient dans la zone sans inducement : zone rejetée.
                        kill := inZone
                    else if bull ? low < z.idm : high > z.idm
                        if biasFilter and nz(biasTrend) != z.dir
                            // Inducement pris mais zone contre le biais : écartée.
                            kill := true
                        else
                            activateZone(z)
                            justOn   := true
                            newZones += 1
                if z.active and inZone and not z.touched
                    z.touched := true
                    if delTouched and not justOn
                        kill := true
                    else
                        color c = zoneColor(z)
                        z.bx.set_bgcolor(color.new(c, math.min(95, color.t(c) + 12)))
            if kill
                deleteZone(z)
                zones.remove(i)
        enforceCap(1)
        enforceCap(-1)

    // C bis) Doji : 1er retour du prix dans la zone, puis clôture de réaction
    //        hors de la zone dans le sens du CHoCH → affiché en violet.
    if dojis.size() > 0
        for i = dojis.size() - 1 to 0
            Doji d       = dojis.get(i)
            bool bull    = d.dir == 1
            bool invalid = bull ? close < d.bottom : close > d.top
            bool kill    = invalid
            if not invalid and not d.active
                if bar_index - d.created > dojiExpiry
                    kill := true
                else
                    if bull ? low <= d.top : high >= d.bottom
                        d.touched := true
                    if d.touched and (bull ? close > d.top : close < d.bottom)
                        d.active := true
                        newDoji  += 1
                        if showDoji
                            d.bx := box.new(d.bar, d.top, bar_index + extBars, d.bottom, border_color = color.new(dojiCol, 0), border_width = 1, bgcolor = dojiCol, text = "Doji", text_size = size.tiny, text_color = color.new(dojiCol, 0), text_halign = text.align_right, text_valign = text.align_center)
            if kill
                deleteDoji(d)
                dojis.remove(i)
        int nAct = 0
        for d in dojis
            if d.active
                nAct += 1
        while nAct > maxDoji
            int idx = -1
            for i = 0 to dojis.size() - 1
                if dojis.get(i).active
                    idx := i
                    break
            deleteDoji(dojis.get(idx))
            dojis.remove(idx)
            nAct -= 1

    // D) Inducement : premier repli interne formé après la cassure, devant la zone
    if not na(ipl) or not na(iph)
        int p = bar_index - idmLen
        for z in zones
            if not z.active and na(z.idm) and p > z.created
                if z.dir == 1 and not na(ipl) and ipl > z.top
                    z.idm    := ipl
                    z.idmBar := p
                else if z.dir == -1 and not na(iph) and iph < z.bottom
                    z.idm    := iph
                    z.idmBar := p

    // E) EQH / EQL : deux petits sommets (ou creux) à moins de eqTol × ATR,
    //    sans que le prix ait dépassé le premier de plus que cette tolérance.
    if not na(eqHiP) and high > eqHiP + eqTol * atr
        eqHiP := na
    if not na(eqLoP) and low < eqLoP - eqTol * atr
        eqLoP := na
    if not na(eph)
        if not na(eqHiP) and math.abs(eph - eqHiP) <= eqTol * atr
            addEqLiq(math.max(eph, eqHiP), eqHiB, true)
        eqHiP := eph
        eqHiB := bar_index - eqLen
    if not na(epl)
        if not na(eqLoP) and math.abs(epl - eqLoP) <= eqTol * atr
            addEqLiq(math.min(epl, eqLoP), eqLoB, false)
        eqLoP := epl
        eqLoB := bar_index - eqLen

    // Nouveaux swings de structure (= nouveaux niveaux de liquidité BSL / SSL)
    if not na(ph)
        shPrice := ph
        shBar   := bar_index - swingLen
        shLive  := true
        addLiq(ph, shBar, true)
    if not na(pl)
        slPrice := pl
        slBar   := bar_index - swingLen
        slLive  := true
        addLiq(pl, slBar, false)

    // F) BOS / CHoCH
    float upSrc = closeBreak ? close : high
    float dnSrc = closeBreak ? close : low
    if shLive and upSrc > shPrice
        shLive := false
        string tag = trend == -1 ? "CHoCH" : "BOS"
        trend   := 1
        lastTag := tag
        drawStruct(shBar, shPrice, tag, 1)
        int len = bar_index - shBar
        if len <= maxLeg
            int   o   = shBar
            float ext = low[len]
            for k = len to 0
                if low[k] <= ext
                    ext := low[k]
                    o   := bar_index - k
            createZones(1, o)
            if tag == "CHoCH"
                collectDoji(1, shBar)
    else if slLive and dnSrc < slPrice
        slLive := false
        string tag = trend == 1 ? "CHoCH" : "BOS"
        trend   := -1
        lastTag := tag
        drawStruct(slBar, slPrice, tag, -1)
        int len = bar_index - slBar
        if len <= maxLeg
            int   o   = slBar
            float ext = high[len]
            for k = len to 0
                if high[k] >= ext
                    ext := high[k]
                    o   := bar_index - k
            createZones(-1, o)
            if tag == "CHoCH"
                collectDoji(-1, slBar)

    if newZones > 0
        alert("KossWin2 : " + str.tostring(newZones) + " zone(s) validée(s) par inducement — " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
    if newDoji > 0
        alert("KossWin2 : " + str.tostring(newDoji) + " doji de CHoCH validé(s) par une 1re réaction — " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
    if sweepHi or sweepLo
        alert("KossWin2 : sweep " + (sweepHi ? "d'EQH" : "d'EQL") + " — " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)

// ─── Sweeps d'EQH / EQL : point rouge ───────────────────────────────────────────────────
plotchar(showSweep and dotSize == "Minuscule" and sweepHi, "Sweep EQH", "•", location.abovebar, sweepCol, size = size.tiny)
plotchar(showSweep and dotSize == "Minuscule" and sweepLo, "Sweep EQL", "•", location.belowbar, sweepCol, size = size.tiny)
plotshape(showSweep and dotSize == "Très petit" and sweepHi, "Sweep EQH (très petit)", shape.circle, location.abovebar, sweepCol, size = size.tiny)
plotshape(showSweep and dotSize == "Très petit" and sweepLo, "Sweep EQL (très petit)", shape.circle, location.belowbar, sweepCol, size = size.tiny)
plotshape(showSweep and dotSize == "Petit" and sweepHi, "Sweep EQH (petit)", shape.circle, location.abovebar, sweepCol, size = size.small)
plotshape(showSweep and dotSize == "Petit" and sweepLo, "Sweep EQL (petit)", shape.circle, location.belowbar, sweepCol, size = size.small)

// ─── Mise à jour visuelle sur la dernière bougie ────────────────────────────
var table panel = table.new(position.top_right, 1, 3, bgcolor = color.new(color.gray, 88), border_width = 0)

if barstate.islast
    for z in zones
        if z.active and not na(z.bx)
            z.bx.set_right(bar_index + extBars)
    for q in liqs
        if not na(q.ln)
            q.ln.set_xy1(q.bar, q.price)
            q.ln.set_xy2(bar_index + 5, q.price)
            q.lb.set_xy(bar_index + 5, q.price)
            q.lb.set_text(liqText(q))
    for d in dojis
        if d.active and not na(d.bx)
            d.bx.set_right(bar_index + extBars)

    if showPanel
        int    bT    = nz(biasTrend)
        string bTxt  = bT == 1 ? "HAUSSIER ▲" : bT == -1 ? "BAISSIER ▼" : "INDÉFINI"
        color  bCol  = bT == 1 ? bullCol : bT == -1 ? bearCol : liqCol
        string tTxt  = trend == 1 ? "HAUSSIÈRE ▲" : trend == -1 ? "BAISSIÈRE ▼" : "INDÉFINIE"
        color  tCol  = trend == 1 ? bullCol : trend == -1 ? bearCol : liqCol
        string align = bT == 0 or trend == 0 ? "Alignement : —" : bT == trend ? "Alignement : ✔ structure dans le sens du biais" : "Alignement : ✘ structure contre le biais"
        table.cell(panel, 0, 0, "KossWin2 · Biais " + tfLabel(biasTF) + " : " + bTxt + " (" + (na(biasTag) ? "—" : biasTag) + ")", text_color = bCol, text_size = size.small, text_halign = text.align_right)
        table.cell(panel, 0, 1, "Structure " + tfLabel(timeframe.period) + " : " + tTxt + " (" + lastTag + ")", text_color = tCol, text_size = size.small, text_halign = text.align_right)
        table.cell(panel, 0, 2, align, text_color = liqCol, text_size = size.small, text_halign = text.align_right)
