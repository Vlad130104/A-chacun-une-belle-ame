//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  KOSS ALGO — Bougies algorithmiques avant un CHoCH
//
//  Étape 1 (unité d'analyse : D1, H4 ou H1, choisie dans les réglages)
//    1. Repère les bougies algorithmiques du DERNIER mouvement avant un CHoCH
//       (dernière jambe baissière avant un CHoCH haussier, et inversement).
//    2. Les trace : rectangle ORANGE plein.
//    3. Encadre le mouvement du CHoCH : rectangle VERT fin.
//  Étape 2 (unité d'entrée = celle du graphique : M5, M15 ou M30)
//    1. Repère les bougies algorithmiques présentes dans la zone verte de
//       l'unité d'analyse.
//    2. Trace celles qui précèdent un CHoCH de l'unité d'entrée : rectangle
//       ORANGE pâle.
//
//  Bougie algorithmique (définition chiffrée, réglable) :
//    corps ≥ 1,5 × ATR(14) ET corps ≥ 70 % de la bougie (petites mèches),
//    dans le sens du mouvement.
//  Tout est calculé sur bougie clôturée : pas de repaint.
//  Fiche : KOSS_ALGO_GUIDE.md
// ═══════════════════════════════════════════════════════════════════════════
indicator("Koss Algo", shorttitle = "Koss Algo", overlay = true, max_boxes_count = 200, max_lines_count = 100, max_labels_count = 100, max_bars_back = 500)

// ─── 1. Étape 1 : unité d'analyse ───────────────────────────────────────────
const string G1 = "1. Étape 1 : unité d'analyse"
iHtf     = input.timeframe("240", "Unité d'analyse", options = ["D", "240", "60"], group = G1, tooltip = "D = Daily, 240 = H4, 60 = H1.")
iHtfLen  = input.int(3, "Swings (structure) de l'unité d'analyse", minval = 2, maxval = 10, group = G1)
iKeepH   = input.int(2, "Mouvements CHoCH gardés à l'écran", minval = 1, maxval = 10, group = G1)

// ─── 2. Étape 2 : unité d'entrée ────────────────────────────────────────────
const string G2 = "2. Étape 2 : unité d'entrée (graphique)"
iShowLtf = input.bool(true, "Bougies algo de l'unité d'entrée", group = G2)
iLtfLen  = input.int(3, "Swings (structure) de l'unité d'entrée", minval = 2, maxval = 10, group = G2)
iInZone  = input.bool(true, "Seulement dans la zone verte de l'unité d'analyse", group = G2)
iShowCh  = input.bool(true, "Afficher le niveau du CHoCH (unité d'entrée)", group = G2)
iKeepL   = input.int(3, "CHoCH gardés à l'écran (unité d'entrée)", minval = 1, maxval = 20, group = G2)

// ─── 3. Définition de la bougie algorithmique ───────────────────────────────
const string G3 = "3. Bougie algorithmique"
iBodyK   = input.float(1.5, "Corps minimal (× ATR 14)", minval = 0.5, step = 0.1, group = G3)
iRatio   = input.float(70, "Corps minimal (% de la bougie)", minval = 30, maxval = 100, step = 5, group = G3) / 100
iMaxAlgo = input.int(3, "Bougies algo max. par mouvement", minval = 1, maxval = 3, group = G3)
iInclImp = input.bool(false, "Chercher aussi dans la jambe du CHoCH", group = G3, tooltip = "Non : seulement le dernier mouvement AVANT le CHoCH (votre règle). Oui : aussi la jambe qui fait le CHoCH.")

// ─── 4. Couleurs ────────────────────────────────────────────────────────────
const string G4 = "4. Couleurs"
cAlgoH   = input.color(#FF9800, "Bougie algo (unité d'analyse)", group = G4)
cAlgoL   = input.color(#FFB74D, "Bougie algo (unité d'entrée)", group = G4)
cZone    = input.color(#00C853, "Mouvement CHoCH (rectangle vert)", group = G4)
cChoch   = input.color(#9E9E9E, "Niveau du CHoCH (unité d'entrée)", group = G4)

// ═══════════════════════════════════════════════════════════════════════════
//  MOTEUR : structure, CHoCH et bougies algo (même code pour les 2 étapes)
//  Retourne le dernier événement CHoCH :
//  [heure CHoCH, début, fin, haut, bas, niveau cassé, sens, nb algo,
//   t1, h1, l1, t2, h2, l2, t3, h3, l3]
// ═══════════════════════════════════════════════════════════════════════════
f_core(int len, float bodyK, float ratio, int maxA, bool inclImp) =>
    var int   tr  = 0
    var float sh  = na
    var float sl  = na
    var int   shB = na
    var int   slB = na
    var bool  shU = true
    var bool  slU = true
    var int   evT = na
    var int   bL  = na
    var int   bR  = na
    var float bT  = na
    var float bB  = na
    var float lvl = na
    var int   dir = 0
    var int   n   = 0
    var int   t1  = na
    var float h1  = na
    var float l1  = na
    var int   t2  = na
    var float h2  = na
    var float l2  = na
    var int   t3  = na
    var float h3  = na
    var float l3  = na
    float atr = ta.atr(14)
    float ph  = ta.pivothigh(high, len, len)
    float pl  = ta.pivotlow(low, len, len)
    if not na(ph)
        sh  := ph
        shB := bar_index - len
        shU := false
    if not na(pl)
        sl  := pl
        slB := bar_index - len
        slU := false
    // up = +1 : cassure haussière ; -1 : cassure baissière
    int up = 0
    if not na(sh) and not shU and close > sh
        shU := true
        up  := 1
    else if not na(sl) and not slU and close < sl
        slU := true
        up  := -1
    if up != 0
        bool choch = tr == -up
        tr := up
        if choch and not na(atr)
            int   kS   = math.min(bar_index - (up == 1 ? shB : slB), 150)
            // Extrême du dernier mouvement (plus bas pour un CHoCH haussier)
            int   kX   = 0
            float ext  = up == 1 ? low : high
            float oppo = up == 1 ? high : low
            for k = 0 to kS
                if up == 1
                    if low[k] < ext
                        ext := low[k]
                        kX  := k
                    oppo := math.max(oppo, high[k])
                else
                    if high[k] > ext
                        ext := high[k]
                        kX  := k
                    oppo := math.min(oppo, low[k])
            // Bougies algo : les plus grands corps qui respectent la définition
            float b1 = 0.0
            float b2 = 0.0
            float b3 = 0.0
            int   k1 = -1
            int   k2 = -1
            int   k3 = -1
            int   kEnd = inclImp ? 0 : kX
            for k = kEnd to kS
                bool inLeg = k >= kX
                // Dans le dernier mouvement : bougies dans le sens de ce mouvement
                // (baissières avant un CHoCH haussier). Dans la jambe du CHoCH : l'inverse.
                bool wantBear = (up == 1) == inLeg
                float body  = math.abs(close[k] - open[k])
                float rng   = high[k] - low[k]
                bool  okDir = wantBear ? close[k] < open[k] : close[k] > open[k]
                if okDir and rng > 0 and body >= bodyK * atr[k] and body >= ratio * rng
                    if body > b1
                        b3 := b2
                        k3 := k2
                        b2 := b1
                        k2 := k1
                        b1 := body
                        k1 := k
                    else if body > b2
                        b3 := b2
                        k3 := k2
                        b2 := body
                        k2 := k
                    else if body > b3
                        b3 := body
                        k3 := k
            evT := time
            bL  := time[kS]
            bR  := time_close
            bT  := up == 1 ? oppo : ext
            bB  := up == 1 ? ext : oppo
            lvl := up == 1 ? sh : sl
            dir := up
            n   := 0
            t1  := na
            t2  := na
            t3  := na
            if k1 >= 0 and maxA >= 1
                t1 := time[k1]
                h1 := high[k1]
                l1 := low[k1]
                n  += 1
            if k2 >= 0 and maxA >= 2
                t2 := time[k2]
                h2 := high[k2]
                l2 := low[k2]
                n  += 1
            if k3 >= 0 and maxA >= 3
                t3 := time[k3]
                h3 := high[k3]
                l3 := low[k3]
                n  += 1
    [evT, bL, bR, bT, bB, lvl, dir, n, t1, h1, l1, t2, h2, l2, t3, h3, l3]

// Version « bougie précédente » pour l'unité d'analyse (aucun repaint)
f_htf() =>
    [a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16] = f_core(iHtfLen, iBodyK, iRatio, iMaxAlgo, iInclImp)
    [a0[1], a1[1], a2[1], a3[1], a4[1], a5[1], a6[1], a7[1], a8[1], a9[1], a10[1], a11[1], a12[1], a13[1], a14[1], a15[1], a16[1]]

[hEvT, hL, hR, hT, hB, hLvl, hDir, hN, hT1, hH1, hL1, hT2, hH2, hL2, hT3, hH3, hL3] = request.security(syminfo.tickerid, iHtf, f_htf(), lookahead = barmerge.lookahead_on)
[lEvT, lL, lR, lT, lB, lLvl, lDir, lN, lT1, lH1, lL1, lT2, lH2, lL2, lT3, lH3, lL3] = f_core(iLtfLen, iBodyK, iRatio, iMaxAlgo, iInclImp)

bool htfOk  = timeframe.in_seconds(iHtf) > timeframe.in_seconds()
int  htfMs  = timeframe.in_seconds(iHtf) * 1000
int  ltfMs  = timeframe.in_seconds() * 1000

// ═══════════════════════════════════════════════════════════════════════════
//  DESSINS (graphique propre : on ne garde que les derniers événements)
// ═══════════════════════════════════════════════════════════════════════════
var array<box>   hBoxes  = array.new<box>()      // rectangles de l'étape 1
var array<int>   hCount  = array.new<int>()      // nb de rectangles par événement
var array<box>   lBoxes  = array.new<box>()      // rectangles de l'étape 2
var array<line>  lLines  = array.new<line>()
var array<label> lLabels = array.new<label>()
var array<int>   lCount  = array.new<int>()
var int   lastH  = na
var int   lastL  = na
// Zone verte active (pour l'étape 2)
var float zTop   = na
var float zBot   = na
var int   zLeft  = na

bool evHtf = false
bool evLtf = false

f_algoBox(int t, float h, float l, int w, color c, int transp, string txt) =>
    box.new(t, h, t + w, l, xloc = xloc.bar_time, border_color = c, border_width = 1, bgcolor = color.new(c, transp), text = txt, text_size = size.tiny, text_color = c, text_valign = text.align_top)

// ── Étape 1 : nouveau CHoCH sur l'unité d'analyse ───────────────────────────
if htfOk and not na(hEvT) and hEvT != nz(lastH, -1)
    lastH := hEvT
    evHtf := true
    string tfTxt = iHtf == "D" ? "D1" : iHtf == "240" ? "H4" : iHtf == "60" ? "H1" : iHtf
    int cnt = 1
    hBoxes.push(box.new(hL, hT, hR, hB, xloc = xloc.bar_time, border_color = cZone, border_width = 1, bgcolor = color.new(cZone, 100), text = "CHoCH " + tfTxt + (hDir == 1 ? " ▲" : " ▼"), text_size = size.tiny, text_color = cZone, text_halign = text.align_left, text_valign = hDir == 1 ? text.align_top : text.align_bottom))
    if not na(hT1)
        hBoxes.push(f_algoBox(hT1, hH1, hL1, htfMs, cAlgoH, 55, "Algo " + tfTxt))
        cnt += 1
    if not na(hT2)
        hBoxes.push(f_algoBox(hT2, hH2, hL2, htfMs, cAlgoH, 55, ""))
        cnt += 1
    if not na(hT3)
        hBoxes.push(f_algoBox(hT3, hH3, hL3, htfMs, cAlgoH, 55, ""))
        cnt += 1
    hCount.push(cnt)
    zTop  := hT
    zBot  := hB
    zLeft := hL
    if hCount.size() > iKeepH
        int del = hCount.shift()
        for j = 1 to del
            hBoxes.shift().delete()

// ── Étape 2 : nouveau CHoCH sur l'unité d'entrée ────────────────────────────
f_inZone(float h, float l, int t) =>
    not iInZone or (not na(zTop) and h >= zBot and l <= zTop and t >= zLeft)

if iShowLtf and barstate.isconfirmed and not na(lEvT) and lEvT != nz(lastL, -1)
    lastL := lEvT
    int cnt = 0
    if not na(lT1) and f_inZone(lH1, lL1, lT1)
        lBoxes.push(f_algoBox(lT1, lH1, lL1, ltfMs, cAlgoL, 75, "algo"))
        cnt += 1
    if not na(lT2) and f_inZone(lH2, lL2, lT2)
        lBoxes.push(f_algoBox(lT2, lH2, lL2, ltfMs, cAlgoL, 75, ""))
        cnt += 1
    if not na(lT3) and f_inZone(lH3, lL3, lT3)
        lBoxes.push(f_algoBox(lT3, lH3, lL3, ltfMs, cAlgoL, 75, ""))
        cnt += 1
    // Le niveau du CHoCH n'est tracé que s'il y a au moins une bougie algo retenue
    bool drawLine = iShowCh and cnt > 0
    if drawLine
        lLines.push(line.new(lL, lLvl, lEvT, lLvl, xloc = xloc.bar_time, color = cChoch, style = line.style_dashed))
        lLabels.push(label.new(lEvT, lLvl, "CHoCH", xloc = xloc.bar_time, style = lDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(cChoch, 100), textcolor = cChoch, size = size.tiny))
    if cnt > 0
        evLtf := true
        lCount.push(cnt * 10 + (drawLine ? 1 : 0))
        if lCount.size() > iKeepL
            int code = lCount.shift()
            for j = 1 to math.floor(code / 10)
                lBoxes.shift().delete()
            if code % 10 == 1
                lLines.shift().delete()
                lLabels.shift().delete()

// Avertissement si l'unité d'analyse n'est pas plus grande que le graphique
var label warn = na
if barstate.islast
    if not na(warn)
        warn.delete()
    if not htfOk
        warn := label.new(bar_index, high, "Koss Algo : l'unité d'analyse doit être plus grande que celle du graphique", style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.small)

// ═══════════════════════════════════════════════════════════════════════════
//  ALERTES
// ═══════════════════════════════════════════════════════════════════════════
alertcondition(evHtf, "Koss Algo : CHoCH + bougies algo (unité d'analyse)", "Koss Algo : nouveau CHoCH avec bougies algorithmiques sur l'unité d'analyse ({{ticker}})")
alertcondition(evLtf, "Koss Algo : bougies algo dans la zone (unité d'entrée)", "Koss Algo : bougies algorithmiques avant un CHoCH dans la zone verte ({{ticker}}, {{interval}})")
