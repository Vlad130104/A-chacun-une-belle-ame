//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  KOSSWIN1 — Smart Money sur un graphique propre
//
//  1. Order Blocks en confluence avec un FVG + zones Supply / Demand,
//     chaque tracé avec sa propre couleur.
//  2. Les zones ne sont tracées qu'APRÈS l'inducement (IDM) : le petit creux
//     (ou sommet) interne qui piège les traders impatients doit être pris.
//  3. Tendance par BOS / CHoCH + niveaux de liquidité (BSL / SSL, EQH / EQL).
//  4. Sweep de liquidité : point rouge.
//  5. Premium / Discount (niveaux 1 – 0,5 – 0) selon la tendance.
//  6. Signaux du setup Koss : 2 zones en escalier, retour dans la dernière
//     zone ou en premium / discount, puis bougie de retournement.
//
//  Tout est calculé sur bougie clôturée : pas de repaint.
//  Fiche : KOSSWIN1_GUIDE.md
// ═══════════════════════════════════════════════════════════════════════════
indicator("KossWin1", shorttitle = "KossWin1", overlay = true, max_boxes_count = 200, max_lines_count = 300, max_labels_count = 300, max_bars_back = 500)

// ─── Constantes des menus ───────────────────────────────────────────────────
const string DIR_AUTO = "Auto (selon le symbole)"
const string DIR_SELL = "Ventes seulement"
const string DIR_BUY  = "Achats seulement"
const string DIR_BOTH = "Achats et ventes"
const string EM_ZONE  = "Dans la zone (OB / Supply / Demand)"
const string EM_BOTH  = "Dans la zone ou en premium / discount"

// ─── 1. Structure ───────────────────────────────────────────────────────────
const string G1 = "1. Structure (BOS / CHoCH)"
iLen     = input.int(5, "Swings externes (structure)", minval = 2, maxval = 20, group = G1, tooltip = "Bougies de chaque côté pour valider un sommet / creux de structure.")
iIntLen  = input.int(2, "Swings internes (inducement)", minval = 1, maxval = 5, group = G1)
iShowStr = input.bool(true, "Afficher BOS / CHoCH", group = G1)

// ─── 2. Zones ───────────────────────────────────────────────────────────────
const string G2 = "2. Zones"
iShowOB  = input.bool(true, "Order Blocks en confluence avec FVG", group = G2)
iShowFvg = input.bool(true, "Afficher le FVG de l'OB", group = G2)
iShowSD  = input.bool(true, "Zones Supply / Demand", group = G2, tooltip = "Zone de base (plusieurs bougies) quand le mouvement n'a pas laissé de FVG.")
iReqIdm  = input.bool(true, "Tracer seulement après inducement (IDM)", group = G2)
iShowIdm = input.bool(true, "Afficher l'inducement", group = G2)
iDisp    = input.float(1.5, "Déplacement minimal (× ATR)", minval = 0.5, step = 0.1, group = G2)
iMaxZ    = input.int(3, "Zones affichées par sens", minval = 1, maxval = 10, group = G2)
iMaxAge  = input.int(300, "Durée de vie d'une zone (bougies)", minval = 20, group = G2)

// ─── 3. Liquidité ───────────────────────────────────────────────────────────
const string G3 = "3. Liquidité"
iShowLiq = input.bool(true, "Niveaux de liquidité (BSL / SSL, EQH / EQL)", group = G3)
iMaxLiq  = input.int(3, "Niveaux par côté", minval = 1, maxval = 10, group = G3)
iEqTol   = input.float(0.1, "Tolérance EQH / EQL (× ATR)", minval = 0.0, step = 0.05, group = G3)
iShowSwp = input.bool(true, "Sweep : point rouge", group = G3)

// ─── 4. Premium / Discount ──────────────────────────────────────────────────
const string G4 = "4. Premium / Discount"
iShowPD  = input.bool(true, "Afficher premium / discount (1 – 0,5 – 0)", group = G4)

// ─── 5. Signaux ─────────────────────────────────────────────────────────────
const string G5 = "5. Signaux (setup Koss)"
iSignals = input.bool(true, "Afficher les signaux", group = G5)
iDir     = input.string(DIR_AUTO, "Sens", options = [DIR_AUTO, DIR_SELL, DIR_BUY, DIR_BOTH], group = G5, tooltip = "Auto : ventes sur PainX / Crash, achats sur GainX / Boom, les deux sinon.")
iMinStep = input.int(2, "Zones en escalier minimum", minval = 1, maxval = 10, group = G5)
iEntry   = input.string(EM_BOTH, "Zone d'entrée", options = [EM_ZONE, EM_BOTH], group = G5)
iMinRR   = input.float(1.5, "Gain / risque minimal (R)", minval = 0.5, step = 0.1, group = G5)
iHtfOn   = input.bool(true, "Filtre : tendance de l'unité supérieure", group = G5)
iHtf     = input.timeframe("240", "Unité supérieure", group = G5)
iPanel   = input.bool(true, "Panneau", group = G5)

// ─── 6. Couleurs (une par type de tracé) ────────────────────────────────────
const string G6 = "6. Couleurs"
cObBull  = input.color(#00897B, "OB + FVG haussier", group = G6)
cObBear  = input.color(#8E24AA, "OB + FVG baissier", group = G6)
cFvg     = input.color(#90A4AE, "FVG", group = G6)
cDemand  = input.color(#1E88E5, "Demand", group = G6)
cSupply  = input.color(#EF6C00, "Supply", group = G6)
cBos     = input.color(#9E9E9E, "BOS", group = G6)
cChoch   = input.color(#FBC02D, "CHoCH", group = G6)
cIdm     = input.color(#F48FB1, "Inducement (IDM)", group = G6)
cLiq     = input.color(#26C6DA, "Liquidité", group = G6)
cSweep   = input.color(#FF1744, "Sweep (point rouge)", group = G6)
cPrem    = input.color(#E57373, "Premium", group = G6)
cDisc    = input.color(#66BB6A, "Discount", group = G6)
cBuy     = input.color(#2E7D32, "Signal d'achat", group = G6)
cSell    = input.color(#C62828, "Signal de vente", group = G6)

// ─── Sens autorisé pour les signaux ─────────────────────────────────────────
string symU   = str.upper(syminfo.ticker + " " + syminfo.description)
bool   isDrop = str.contains(symU, "PAINX") or str.contains(symU, "CRASH") or str.contains(symU, "PRICE DROP")
bool   isPump = str.contains(symU, "GAINX") or str.contains(symU, "BOOM") or str.contains(symU, "PRICE RISE") or str.contains(symU, "PRICE JUMP")
bool   famDrop = isDrop and not isPump
bool   famPump = isPump and not isDrop
bool   autoMd  = iDir == DIR_AUTO
bool   allowSell = iDir == DIR_SELL or iDir == DIR_BOTH or (autoMd and not famPump)
bool   allowBuy  = iDir == DIR_BUY or iDir == DIR_BOTH or (autoMd and not famDrop)

// ─── Types ──────────────────────────────────────────────────────────────────
type Zone
    int   dir                  // +1 = haussière (achat), -1 = baissière (vente)
    int   kind                 // 1 = OB + FVG, 2 = Supply / Demand
    float top
    float bot
    int   left
    int   born
    float fTop  = na
    float fBot  = na
    int   fLeft = na
    float idm   = na
    int   idmBar = na
    bool  valid    = false
    bool  touched  = false
    bool  signaled = false
    box   bx    = na
    box   fbx   = na
    line  idmLn = na
    label idmLb = na

type Liq
    float price
    int   bar
    bool  isHigh
    line  ln = na
    label lb = na

// ─── État ───────────────────────────────────────────────────────────────────
var array<Zone>  zones   = array.new<Zone>()
var array<Liq>   liqs    = array.new<Liq>()
var array<line>  sLines  = array.new<line>()
var array<label> sLabels = array.new<label>()
var int    trend    = 0
var float  swH      = na
var int    swHBar   = na
var bool   swHUsed  = true
var float  swL      = na
var int    swLBar   = na
var bool   swLUsed  = true
var float  lastIph  = na
var int    lastIphBar = na
var float  lastIpl  = na
var int    lastIplBar = na
var float  rHi      = na
var float  rLo      = na
var int    rStart   = na
var int    rDir     = 0
var int    bullSteps = 0
var int    bearSteps = 0
var float  prevBullBot = na
var float  prevBearTop = na
var int    tchS     = -1000
var int    tchB     = -1000
var float  slRefS   = na
var float  slRefB   = na
var int    lastSigBar = -1000
var string lastSig  = "aucun"

// Événements de la bougie (alertes)
bool evSweepHi = false
bool evSweepLo = false
bool evChochUp = false
bool evChochDn = false
bool evZone    = false
bool evBuy     = false
bool evSell    = false

// ─── Séries (calculées à chaque bougie) ─────────────────────────────────────
float atr = ta.atr(14)
float ph  = ta.pivothigh(high, iLen, iLen)
float pl  = ta.pivotlow(low, iLen, iLen)
float iph = ta.pivothigh(high, iIntLen, iIntLen)
float ipl = ta.pivotlow(low, iIntLen, iIntLen)

// Tendance de l'unité supérieure (même logique BOS / CHoCH, sans repaint)
f_trend(int len) =>
    var int   t = 0
    var float h = na
    var float l = na
    float p1 = ta.pivothigh(high, len, len)
    float p2 = ta.pivotlow(low, len, len)
    if not na(p1)
        h := p1
    if not na(p2)
        l := p2
    if not na(h) and close > h
        t := 1
        h := na
    if not na(l) and close < l
        t := -1
        l := na
    t
bool htfUsable = timeframe.in_seconds(iHtf) > timeframe.in_seconds()
int  htfTrend  = request.security(syminfo.tickerid, iHtf, f_trend(iLen)[1], lookahead = barmerge.lookahead_on)

// ─── Fonctions de dessin ────────────────────────────────────────────────────
f_px(float p) => str.tostring(p, format.mintick)

f_tfName(string tf) =>
    tf == "240" ? "H4" : tf == "60" ? "H1" : tf == "30" ? "M30" : tf == "15" ? "M15" : tf == "D" or tf == "1D" ? "D1" : tf

// BOS / CHoCH : ligne pointillée + petit texte (on garde les 10 derniers)
f_struct(int x1, float y, bool choch, bool up) =>
    if iShowStr
        color c  = choch ? cChoch : cBos
        int   xm = math.floor((x1 + bar_index) / 2)
        sLines.push(line.new(x1, y, bar_index, y, color = c, style = line.style_dashed, width = choch ? 2 : 1))
        sLabels.push(label.new(xm, y, choch ? "CHoCH" : "BOS", style = up ? label.style_label_down : label.style_label_up, color = color.new(c, 100), textcolor = c, size = size.tiny))
        if sLines.size() > 10
            sLines.shift().delete()
            sLabels.shift().delete()

f_drawZone(Zone z) =>
    bool show = z.kind == 1 ? iShowOB : iShowSD
    if show
        color  c = z.kind == 1 ? (z.dir == 1 ? cObBull : cObBear) : (z.dir == 1 ? cDemand : cSupply)
        string t = z.kind == 1 ? "OB + FVG" : (z.dir == 1 ? "Demand" : "Supply")
        z.bx := box.new(z.left, z.top, bar_index + 5, z.bot, border_color = c, bgcolor = color.new(c, 80), text = t, text_size = size.tiny, text_color = c, text_halign = text.align_right, text_valign = z.dir == 1 ? text.align_bottom : text.align_top)
        if z.kind == 1 and iShowFvg and not na(z.fTop)
            z.fbx := box.new(z.fLeft, z.fTop, bar_index + 5, z.fBot, border_color = color.new(cFvg, 30), border_style = line.style_dotted, bgcolor = color.new(cFvg, 90), text = "FVG", text_size = size.tiny, text_color = cFvg, text_halign = text.align_left)
    if iShowIdm and not na(z.idm)
        z.idmLn := line.new(z.idmBar, z.idm, bar_index, z.idm, color = cIdm, style = line.style_dotted)
        z.idmLb := label.new(bar_index, z.idm, "IDM", style = label.style_label_left, color = color.new(cIdm, 100), textcolor = cIdm, size = size.tiny)

f_delZone(Zone z) =>
    if not na(z.bx)
        z.bx.delete()
    if not na(z.fbx)
        z.fbx.delete()
    if not na(z.idmLn)
        z.idmLn.delete()
    if not na(z.idmLb)
        z.idmLb.delete()

f_fadeZone(Zone z) =>
    if not na(z.bx)
        color c = z.kind == 1 ? (z.dir == 1 ? cObBull : cObBear) : (z.dir == 1 ? cDemand : cSupply)
        z.bx.set_bgcolor(color.new(c, 93))
        z.bx.set_border_color(color.new(c, 60))
        z.bx.set_text_color(color.new(c, 50))

// Crée une zone ; elle n'est tracée qu'une fois l'inducement pris (si l'option est active)
f_newZone(int dir, int kind, float top, float bot, int left, float fT, float fB, int fL) =>
    Zone z = Zone.new(dir, kind, top, bot, left, bar_index, fT, fB, fL)
    // Inducement : dernier creux interne (zone haussière) / sommet interne (zone baissière)
    // formé APRÈS l'origine de la zone, entre la zone et le prix.
    if dir == 1 and not na(lastIpl) and lastIplBar > left and lastIpl > top and lastIpl < close
        z.idm    := lastIpl
        z.idmBar := lastIplBar
    if dir == -1 and not na(lastIph) and lastIphBar > left and lastIph < bot and lastIph > close
        z.idm    := lastIph
        z.idmBar := lastIphBar
    z.valid := not iReqIdm
    if z.valid
        f_drawZone(z)
    zones.push(z)
    z

f_addLiq(float p, int b, bool isHigh, float tol) =>
    Liq nl = Liq.new(p, b, isHigh)
    bool eq = false
    int  x1 = b
    for o in liqs
        if o.isHigh == isHigh and math.abs(o.price - p) <= tol
            eq := true
            x1 := math.min(x1, o.bar)
    if iShowLiq
        nl.ln := line.new(x1, p, bar_index, p, extend = extend.right, color = color.new(cLiq, 20), style = line.style_dotted)
        nl.lb := label.new(b, p, eq ? (isHigh ? "EQH" : "EQL") : (isHigh ? "BSL" : "SSL"), style = isHigh ? label.style_label_down : label.style_label_up, color = color.new(cLiq, 100), textcolor = cLiq, size = size.tiny)
    liqs.push(nl)
    // Nettoyage : iMaxLiq niveaux par côté
    int cnt = 0
    for o in liqs
        if o.isHigh == isHigh
            cnt += 1
    if cnt > iMaxLiq
        for j = 0 to liqs.size() - 1
            Liq o = liqs.get(j)
            if o.isHigh == isHigh
                if not na(o.ln)
                    o.ln.delete()
                if not na(o.lb)
                    o.lb.delete()
                liqs.remove(j)
                break

// ═══════════════════════════════════════════════════════════════════════════
//  LOGIQUE (bougies clôturées uniquement)
// ═══════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed and not na(atr)

    // ── A. Swings internes (pour l'inducement) ──────────────────────────────
    if not na(iph)
        lastIph    := iph
        lastIphBar := bar_index - iIntLen
    if not na(ipl)
        lastIpl    := ipl
        lastIplBar := bar_index - iIntLen

    // ── B. Liquidité : sweep (mèche au-delà, clôture en retour) ou prise ────
    if liqs.size() > 0
        for i = liqs.size() - 1 to 0
            Liq L = liqs.get(i)
            bool hit = L.isHigh ? high > L.price : low < L.price
            if hit
                bool sweep = L.isHigh ? close < L.price : close > L.price
                if sweep and L.isHigh
                    evSweepHi := true
                if sweep and not L.isHigh
                    evSweepLo := true
                if not na(L.ln)
                    L.ln.delete()
                if not na(L.lb)
                    L.lb.delete()
                liqs.remove(i)

    // ── C. Nouveaux swings externes = nouveaux niveaux de liquidité ─────────
    if not na(ph)
        swH     := ph
        swHBar  := bar_index - iLen
        swHUsed := false
        f_addLiq(ph, bar_index - iLen, true, iEqTol * atr)
    if not na(pl)
        swL     := pl
        swLBar  := bar_index - iLen
        swLUsed := false
        f_addLiq(pl, bar_index - iLen, false, iEqTol * atr)

    // ── D. Cassure haussière : BOS ou CHoCH ─────────────────────────────────
    if not na(swH) and not swHUsed and close > swH
        bool choch = trend == -1
        trend   := 1
        swHUsed := true
        f_struct(swHBar, swH, choch, true)
        if choch
            evChochUp   := true
            bearSteps   := 0
            prevBearTop := na
        // Origine du mouvement : plus bas creux depuis le sommet cassé
        int   n  = math.max(math.min(bar_index - swHBar, 100), 1)
        int   k0 = 0
        float lo = low
        for k = 1 to n
            if low[k] < lo
                lo := low[k]
                k0 := k
        float legHi = high
        for k = 0 to k0
            legHi := math.max(legHi, high[k])
        // Plage premium / discount de la tendance haussière
        rDir   := 1
        rLo    := lo
        rHi    := legHi
        rStart := bar_index - k0
        // Order Block : dernière bougie baissière avant la hausse
        int obK = k0
        for k = k0 to k0 + 3
            if close[k] < open[k]
                obK := k
                break
        float obTop = high[obK]
        float obBot = math.min(low[obK], lo)
        // FVG haussier juste après l'OB (bas de la 3ᵉ bougie > haut de la 1ʳᵉ)
        float fT = na
        float fB = na
        int   fL = na
        int   jS = obK - 2
        if jS >= 0
            for j = jS to math.max(obK - 6, 0)
                if low[j] > high[j + 2]
                    fT := low[j]
                    fB := high[j + 2]
                    fL := bar_index - (j + 2)
                    break
        if legHi - lo >= iDisp * atr
            if not na(fT)
                f_newZone(1, 1, obTop, obBot, bar_index - obK, fT, fB, fL)
                bullSteps   := bullSteps > 0 and not na(prevBullBot) and obBot > prevBullBot ? bullSteps + 1 : 1
                prevBullBot := obBot
            else
                // Demand : base de 1 à 3 bougies autour de l'origine
                float dTop = math.max(open[k0], close[k0])
                float dBot = lo
                int   kA   = math.max(k0 - 1, 0)
                for k = kA to k0 + 1
                    dTop := math.max(dTop, math.max(open[k], close[k]))
                    dBot := math.min(dBot, low[k])
                f_newZone(1, 2, dTop, dBot, bar_index - (k0 + 1), na, na, na)
                bullSteps   := bullSteps > 0 and not na(prevBullBot) and dBot > prevBullBot ? bullSteps + 1 : 1
                prevBullBot := dBot

    // ── D bis. Cassure baissière : BOS ou CHoCH ─────────────────────────────
    if not na(swL) and not swLUsed and close < swL
        bool choch = trend == 1
        trend   := -1
        swLUsed := true
        f_struct(swLBar, swL, choch, false)
        if choch
            evChochDn   := true
            bullSteps   := 0
            prevBullBot := na
        int   n  = math.max(math.min(bar_index - swLBar, 100), 1)
        int   k0 = 0
        float hi = high
        for k = 1 to n
            if high[k] > hi
                hi := high[k]
                k0 := k
        float legLo = low
        for k = 0 to k0
            legLo := math.min(legLo, low[k])
        rDir   := -1
        rHi    := hi
        rLo    := legLo
        rStart := bar_index - k0
        // Order Block : dernière bougie haussière avant la baisse
        int obK = k0
        for k = k0 to k0 + 3
            if close[k] > open[k]
                obK := k
                break
        float obTop = math.max(high[obK], hi)
        float obBot = low[obK]
        // FVG baissier juste après l'OB (haut de la 3ᵉ bougie < bas de la 1ʳᵉ)
        float fT = na
        float fB = na
        int   fL = na
        int   jS = obK - 2
        if jS >= 0
            for j = jS to math.max(obK - 6, 0)
                if high[j] < low[j + 2]
                    fT := low[j + 2]
                    fB := high[j]
                    fL := bar_index - (j + 2)
                    break
        if hi - legLo >= iDisp * atr
            if not na(fT)
                f_newZone(-1, 1, obTop, obBot, bar_index - obK, fT, fB, fL)
                bearSteps   := bearSteps > 0 and not na(prevBearTop) and obTop < prevBearTop ? bearSteps + 1 : 1
                prevBearTop := obTop
            else
                // Supply : base de 1 à 3 bougies autour de l'origine
                float sBot = math.min(open[k0], close[k0])
                float sTop = hi
                int   kA   = math.max(k0 - 1, 0)
                for k = kA to k0 + 1
                    sBot := math.min(sBot, math.min(open[k], close[k]))
                    sTop := math.max(sTop, high[k])
                f_newZone(-1, 2, sTop, sBot, bar_index - (k0 + 1), na, na, na)
                bearSteps   := bearSteps > 0 and not na(prevBearTop) and sTop < prevBearTop ? bearSteps + 1 : 1
                prevBearTop := sTop

    // ── E. Plage premium / discount : suit le prix dans le sens de la tendance
    if rDir == 1
        rHi := math.max(rHi, high)
    if rDir == -1
        rLo := math.min(rLo, low)

    // ── F. Vie des zones : inducement, contact, cassure, expiration ─────────
    if zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            bool kill = bar_index - z.born > iMaxAge
            if z.dir == 1
                kill := kill or close < z.bot
                if not kill and not z.valid
                    if na(z.idm) and not na(ipl) and ipl > z.top
                        z.idm    := ipl
                        z.idmBar := bar_index - iIntLen
                    if not na(z.idm) and low < z.idm and bar_index - iIntLen >= z.idmBar
                        z.valid := true
                        evZone  := true
                        f_drawZone(z)
                if not kill and z.valid and not z.touched and z.born < bar_index and low <= z.top
                    z.touched := true
                    f_fadeZone(z)
            else
                kill := kill or close > z.top
                if not kill and not z.valid
                    if na(z.idm) and not na(iph) and iph < z.bot
                        z.idm    := iph
                        z.idmBar := bar_index - iIntLen
                    if not na(z.idm) and high > z.idm and bar_index - iIntLen >= z.idmBar
                        z.valid := true
                        evZone  := true
                        f_drawZone(z)
                if not kill and z.valid and not z.touched and z.born < bar_index and high >= z.bot
                    z.touched := true
                    f_fadeZone(z)
            if kill
                f_delZone(z)
                zones.remove(i)
            else
                if not na(z.bx)
                    z.bx.set_right(bar_index + 5)
                if not na(z.fbx)
                    z.fbx.set_right(bar_index + 5)
        // Graphique propre : iMaxZ zones valides par sens, 6 zones en attente par sens
        for d = -1 to 1 by 2
            int nv = 0
            int np = 0
            for z in zones
                if z.dir == d
                    nv += z.valid ? 1 : 0
                    np += z.valid ? 0 : 1
            if nv > iMaxZ or np > 6
                for j = 0 to zones.size() - 1
                    Zone z = zones.get(j)
                    if z.dir == d and ((nv > iMaxZ and z.valid) or (np > 6 and not z.valid))
                        f_delZone(z)
                        zones.remove(j)
                        break

    // ── G. Signaux du setup Koss ────────────────────────────────────────────
    if iSignals and not na(rHi) and not na(rLo) and rHi > rLo
        float mid  = (rHi + rLo) / 2
        bool  htfS = not iHtfOn or not htfUsable or htfTrend == -1
        bool  htfB = not iHtfOn or not htfUsable or htfTrend == 1
        // Dernière zone valide de chaque sens, pas encore utilisée
        Zone zS = na
        Zone zB = na
        if zones.size() > 0
            for i = zones.size() - 1 to 0
                Zone z = zones.get(i)
                if z.valid and not z.signaled
                    if z.dir == -1 and na(zS)
                        zS := z
                    if z.dir == 1 and na(zB)
                        zB := z
        // Contact : dans la zone, ou en premium (vente) / discount (achat)
        bool inZoneS = not na(zS) and high >= zS.bot
        bool inPremS = iEntry == EM_BOTH and rDir == -1 and high >= mid
        if inZoneS or inPremS
            tchS   := bar_index
            slRefS := inZoneS ? zS.top : rHi
        bool inZoneB = not na(zB) and low <= zB.top
        bool inDiscB = iEntry == EM_BOTH and rDir == 1 and low <= mid
        if inZoneB or inDiscB
            tchB   := bar_index
            slRefB := inZoneB ? zB.bot : rLo
        // Retournement : bougie baissière qui clôture sous le plus bas précédent (et miroir)
        bool revDn = close < open and close < low[1]
        bool revUp = close > open and close > high[1]
        if allowSell and trend == -1 and htfS and bearSteps >= iMinStep and revDn and bar_index - tchS <= 3 and bar_index - lastSigBar > 5
            float sl = slRefS + 0.2 * atr
            float tp = rLo
            float rr = sl > close and tp < close ? (close - tp) / (sl - close) : 0.0
            if rr >= iMinRR
                label.new(bar_index, high, "VENTE", style = label.style_label_down, color = cSell, textcolor = color.white, size = size.small, tooltip = "Entrée " + f_px(close) + "\nStop " + f_px(sl) + "\nObjectif (niveau 0) " + f_px(tp) + "\nGain / risque " + str.tostring(rr, "0.0") + "R\nEscalier : " + str.tostring(bearSteps) + " zones")
                if not na(zS) and inZoneS
                    zS.signaled := true
                lastSigBar := bar_index
                lastSig    := "VENTE " + f_px(close) + " (" + str.tostring(rr, "0.0") + "R)"
                evSell     := true
                alert("KossWin1 : VENTE " + syminfo.ticker + " à " + f_px(close) + " | stop " + f_px(sl) + " | objectif " + f_px(tp) + " | " + str.tostring(rr, "0.0") + "R", alert.freq_once_per_bar_close)
        if allowBuy and trend == 1 and htfB and bullSteps >= iMinStep and revUp and bar_index - tchB <= 3 and bar_index - lastSigBar > 5
            float sl = slRefB - 0.2 * atr
            float tp = rHi
            float rr = sl < close and tp > close ? (tp - close) / (close - sl) : 0.0
            if rr >= iMinRR
                label.new(bar_index, low, "ACHAT", style = label.style_label_up, color = cBuy, textcolor = color.white, size = size.small, tooltip = "Entrée " + f_px(close) + "\nStop " + f_px(sl) + "\nObjectif (niveau 0) " + f_px(tp) + "\nGain / risque " + str.tostring(rr, "0.0") + "R\nEscalier : " + str.tostring(bullSteps) + " zones")
                if not na(zB) and inZoneB
                    zB.signaled := true
                lastSigBar := bar_index
                lastSig    := "ACHAT " + f_px(close) + " (" + str.tostring(rr, "0.0") + "R)"
                evBuy      := true
                alert("KossWin1 : ACHAT " + syminfo.ticker + " à " + f_px(close) + " | stop " + f_px(sl) + " | objectif " + f_px(tp) + " | " + str.tostring(rr, "0.0") + "R", alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════════════════════════════
//  SWEEPS : point rouge
// ═══════════════════════════════════════════════════════════════════════════
plotshape(iShowSwp and evSweepHi, "Sweep (haut)", shape.circle, location.abovebar, cSweep, size = size.small)
plotshape(iShowSwp and evSweepLo, "Sweep (bas)", shape.circle, location.belowbar, cSweep, size = size.small)

// ═══════════════════════════════════════════════════════════════════════════
//  PREMIUM / DISCOUNT (niveaux 1 – 0,5 – 0, comme l'outil Fibonacci)
// ═══════════════════════════════════════════════════════════════════════════
var box   pBox = na
var box   dBox = na
var line  eqLn = na
var label lTop = na
var label lMid = na
var label lBot = na
if barstate.islast
    if not na(pBox)
        pBox.delete()
        dBox.delete()
        eqLn.delete()
        lTop.delete()
        lMid.delete()
        lBot.delete()
    if iShowPD and rDir != 0 and not na(rHi) and not na(rLo) and rHi > rLo
        float mid = (rHi + rLo) / 2
        int   x2  = bar_index + 15
        pBox := box.new(rStart, rHi, x2, mid, border_color = color.new(cPrem, 85), bgcolor = color.new(cPrem, 90), text = "Premium", text_size = size.tiny, text_color = color.new(cPrem, 20), text_halign = text.align_right, text_valign = text.align_top)
        dBox := box.new(rStart, mid, x2, rLo, border_color = color.new(cDisc, 85), bgcolor = color.new(cDisc, 90), text = "Discount", text_size = size.tiny, text_color = color.new(cDisc, 20), text_halign = text.align_right, text_valign = text.align_bottom)
        eqLn := line.new(rStart, mid, x2, mid, color = color.new(color.gray, 30), style = line.style_dashed)
        // Le Fibonacci se trace du début du mouvement (1) vers sa fin (0)
        lTop := label.new(x2, rHi, rDir == -1 ? "1" : "0", style = label.style_label_left, color = color.new(color.gray, 100), textcolor = color.gray, size = size.tiny)
        lMid := label.new(x2, mid, "0.5", style = label.style_label_left, color = color.new(color.gray, 100), textcolor = color.gray, size = size.tiny)
        lBot := label.new(x2, rLo, rDir == -1 ? "0" : "1", style = label.style_label_left, color = color.new(color.gray, 100), textcolor = color.gray, size = size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
//  PANNEAU
// ═══════════════════════════════════════════════════════════════════════════
var table tb = table.new(position.bottom_right, 2, 7, bgcolor = color.new(#131722, 15), border_color = color.new(color.gray, 70), border_width = 1)

f_row(int r, string a, string b, color cb) =>
    tb.cell(0, r, a, text_color = color.new(color.white, 30), text_size = size.small, text_halign = text.align_left)
    tb.cell(1, r, b, text_color = cb, text_size = size.small, text_halign = text.align_right)

f_trTxt(int t) => t == 1 ? "haussière" : t == -1 ? "baissière" : "–"
f_trCol(int t) => t == 1 ? cObBull : t == -1 ? cObBear : color.gray

if iPanel and barstate.islast
    tb.cell(0, 0, "KossWin1", text_color = color.white, text_size = size.normal, text_halign = text.align_left)
    tb.cell(1, 0, syminfo.ticker, text_color = color.white, text_size = size.normal, text_halign = text.align_right)
    f_row(1, "Tendance " + f_tfName(timeframe.period), f_trTxt(trend), f_trCol(trend))
    f_row(2, "Tendance " + f_tfName(iHtf), htfUsable ? f_trTxt(htfTrend) : "unité trop petite", htfUsable ? f_trCol(htfTrend) : color.gray)
    float midP = (rHi + rLo) / 2
    f_row(3, "Prix en", na(midP) ? "–" : close >= midP ? "PREMIUM" : "DISCOUNT", na(midP) ? color.gray : close >= midP ? cPrem : cDisc)
    f_row(4, "Escalier offre / demande", str.tostring(bearSteps) + " / " + str.tostring(bullSteps), color.white)
    f_row(5, "Sens des signaux", allowSell and allowBuy ? "achats et ventes" : allowSell ? "ventes" : "achats", color.white)
    f_row(6, "Dernier signal", lastSig, color.white)

// ═══════════════════════════════════════════════════════════════════════════
//  ALERTES
// ═══════════════════════════════════════════════════════════════════════════
alertcondition(evSell, "KossWin1 : VENTE", "KossWin1 : signal de VENTE sur {{ticker}} ({{interval}}) à {{close}}")
alertcondition(evBuy, "KossWin1 : ACHAT", "KossWin1 : signal d'ACHAT sur {{ticker}} ({{interval}}) à {{close}}")
alertcondition(evSweepHi or evSweepLo, "KossWin1 : sweep de liquidité", "KossWin1 : sweep de liquidité sur {{ticker}} ({{interval}})")
alertcondition(evChochUp or evChochDn, "KossWin1 : CHoCH", "KossWin1 : changement de structure (CHoCH) sur {{ticker}} ({{interval}})")
alertcondition(evZone, "KossWin1 : zone validée (IDM pris)", "KossWin1 : nouvelle zone validée par l'inducement sur {{ticker}} ({{interval}})")
