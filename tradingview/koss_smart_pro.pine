//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  KOSS SMART PRO  —  modèle ICT « Liquidité → MSS → FVG → Entrée en killzone »
//
//  1. BIAIS      : structure du timeframe supérieur (BOS) + premium / discount.
//  2. LIQUIDITÉ  : PDH / PDL, range asiatique, sommets / creux (BSL / SSL),
//                  égaux (EQH / EQL).
//  3. SWEEP      : la mèche dépasse un niveau de liquidité, la clôture revient.
//  4. MSS        : cassure de la structure interne (CHoCH / BOS) dans le sens
//                  du biais, avec un FVG laissé par le déplacement.
//  5. ENTRÉE     : retour dans le FVG (ou l'OB) valide et NON mitigé,
//                  pendant une killzone (Londres / New York).
//  6. GESTION    : stop sous / au-dessus du sweep, TP1 à 1R (partiel + stop
//                  à l'entrée), TP2 sur la liquidité opposée.
//  7. STATISTIQUES : taux de TP1, taux de TP2, résultat en R, mesurés sur
//                  l'historique affiché. C'est ce tableau qui dit si l'objectif
//                  de 70 % est atteint sur VOTRE marché — pas une promesse.
//
//  Aucun repaint : toute la logique est exécutée à la clôture de bougie.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Koss Smart Pro", shorttitle = "Koss Pro", overlay = true,
     max_boxes_count = 100, max_lines_count = 300, max_labels_count = 300, max_bars_back = 500)

// ═══════════════════════════════════════════════════════════════════════════
// 1. PARAMÈTRES
// ═══════════════════════════════════════════════════════════════════════════
const string G_BIAS = "1. Biais (timeframe supérieur)"
htfTf    = input.timeframe("240", "Timeframe du biais", group = G_BIAS,
     tooltip = "M1-M5 → H1 ; M5-M15 → H4 ; H1 → D. Doit être supérieur au timeframe du graphique.")
htfLen   = input.int(5, "Longueur du swing HTF", minval = 1, maxval = 50, group = G_BIAS)
useBias  = input.bool(true, "Trader seulement dans le sens du biais HTF", group = G_BIAS)
usePD    = input.bool(true, "Achats en discount / ventes en premium", group = G_BIAS,
     tooltip = "Discount = sous le milieu du dernier range HTF (swing haut / swing bas). Premium = au-dessus.")

const string G_LIQ = "2. Liquidité"
usePDHL  = input.bool(true, "Plus haut / plus bas de la veille (PDH / PDL)", group = G_LIQ)
useAsia  = input.bool(true, "Range asiatique (AS H / AS L)", group = G_LIQ)
asiaSess = input.session("2000-2359", "Session asiatique (heure de New York)", group = G_LIQ)
useSwing = input.bool(true, "Sommets / creux récents (BSL / SSL, EQH / EQL)", group = G_LIQ)
liqLen   = input.int(5, "Longueur des swings de liquidité", minval = 2, maxval = 30, group = G_LIQ)
eqTol    = input.float(0.1, "Tolérance EQH / EQL (x ATR)", minval = 0.0, maxval = 1.0, step = 0.05, group = G_LIQ)
showLiq  = input.bool(true, "Afficher les niveaux de liquidité", group = G_LIQ)

const string G_TRG = "3. Déclencheur (timeframe d'entrée)"
mssLen   = input.int(3, "Longueur des swings internes (MSS)", minval = 1, maxval = 10, group = G_TRG)
sweepWin = input.int(20, "Délai max. sweep → MSS (bougies)", minval = 3, maxval = 100, group = G_TRG)
zoneMode = input.string("FVG", "Zone d'entrée", options = ["FVG", "Order Block", "FVG + OB"], group = G_TRG)
entryMode = input.string("Milieu (CE)", "Prix d'entrée", options = ["Bord de la zone", "Milieu (CE)"], group = G_TRG,
     tooltip = "Bord = premier contact (plus d'entrées). Milieu (CE, 50 %) = entrée plus profonde (stop plus court, moins d'entrées).")
entryExp = input.int(20, "Expiration de l'ordre (bougies)", minval = 3, maxval = 200, group = G_TRG)
slBuf    = input.float(0.1, "Marge du stop au-delà du sweep (x ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = G_TRG)

const string G_SES = "4. Sessions"
useKZ    = input.bool(true, "Entrées seulement en killzone", group = G_SES)
kzLon    = input.session("0200-0500", "Killzone Londres (heure de New York)", group = G_SES)
kzNy     = input.session("0700-1000", "Killzone New York (heure de New York)", group = G_SES)
maxDay   = input.int(2, "Trades max. par jour", minval = 1, maxval = 10, group = G_SES)

const string G_TP = "5. Objectifs"
tp1R     = input.float(1.0, "TP1 (en R)", minval = 0.5, maxval = 5.0, step = 0.1, group = G_TP)
partPct  = input.int(50, "Part fermée à TP1 (%)", minval = 0, maxval = 100, group = G_TP)
minRoom  = input.float(1.5, "Espace min. jusqu'à la liquidité opposée (en R)", minval = 1.0, maxval = 10.0, step = 0.1, group = G_TP,
     tooltip = "Si un niveau de liquidité opposé est plus proche que ça, le setup est ignoré (pas assez de place).")
fallbackR = input.float(2.0, "TP2 si aucune liquidité opposée (en R)", minval = 1.0, maxval = 10.0, step = 0.1, group = G_TP)

const string G_VIS = "6. Affichage"
keepT     = input.int(3, "Trades gardés sur le graphique", minval = 1, maxval = 20, group = G_VIS)
showPanel = input.bool(true, "Panneau (biais, session, état, statistiques)", group = G_VIS)
maxTf     = input.timeframe("60", "Fonctionne jusqu'au timeframe", group = G_VIS)
bullCol   = input.color(#089981, "Haussier", group = G_VIS, inline = "c")
bearCol   = input.color(#F23645, "Baissier", group = G_VIS, inline = "c")
neutCol   = input.color(#787B86, "Neutre", group = G_VIS, inline = "c")
transpIn  = input.int(85, "Transparence des zones", minval = 80, maxval = 100, group = G_VIS)

// ═══════════════════════════════════════════════════════════════════════════
// 2. CALCULS DE BASE
// ═══════════════════════════════════════════════════════════════════════════
const string NY = "America/New_York"
float atr    = ta.atr(14)
bool  tfOk   = timeframe.isintraday and timeframe.in_seconds() <= timeframe.in_seconds(maxTf)

// Sessions
bool inAsia  = not na(time(timeframe.period, asiaSess, NY))
bool inLon   = not na(time(timeframe.period, kzLon, NY))
bool inNy    = not na(time(timeframe.period, kzNy, NY))
bool kzOk    = not useKZ or inLon or inNy
bool asiaEnd = not inAsia and inAsia[1]
bool newDay  = timeframe.change("D")

// Veille
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// Biais HTF : tendance par cassure du dernier swing + dernier range (pour premium / discount)
f_htf(int len) =>
    var float sh    = na
    var float sl    = na
    var float lastH = na
    var float lastL = na
    var int   t     = 0
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    if not na(ph)
        sh    := ph
        lastH := ph
    if not na(pl)
        sl    := pl
        lastL := pl
    if not na(sh) and close > sh
        t  := 1
        sh := na
    if not na(sl) and close < sl
        t  := -1
        sl := na
    // [1] : valeurs de la bougie HTF précédente, déjà clôturée (pas de repaint)
    [t[1], lastH[1], lastL[1]]

[htfT, htfH, htfL] = request.security(syminfo.tickerid, htfTf, f_htf(htfLen), lookahead = barmerge.lookahead_on)
bool  htfValid = timeframe.in_seconds(htfTf) > timeframe.in_seconds()
float eqPx     = (htfH + htfL) / 2

f_biasOk(int d) =>
    not useBias or not htfValid or htfT == d
f_pdOk(int d, float px) =>
    not usePD or not htfValid or na(eqPx) or (d == 1 ? px < eqPx : px > eqPx)

// Le prix atteint un niveau dans le sens du trade (fav) ou contre le trade (adv)
f_fav(int d, float lvl) =>
    d == 1 ? high >= lvl : low <= lvl
f_adv(int d, float lvl) =>
    d == 1 ? low <= lvl : high >= lvl

// Pivots : liquidité (swings externes) et structure interne (MSS)
float liqPH = ta.pivothigh(high, liqLen, liqLen)
float liqPL = ta.pivotlow(low, liqLen, liqLen)
float iPH   = ta.pivothigh(high, mssLen, mssLen)
float iPL   = ta.pivotlow(low, mssLen, mssLen)

// ═══════════════════════════════════════════════════════════════════════════
// 3. TYPES : niveau de liquidité et trade
// ═══════════════════════════════════════════════════════════════════════════
type Pool
    float  price
    string name
    int    side      // 1 = liquidité au-dessus (BSL), -1 = en dessous (SSL)
    bool   swing     // true = BSL / SSL / EQH / EQL (on n'en garde que 2 par côté)
    line   ln
    label  lb

type Trade
    int   d          // 1 = achat, -1 = vente
    int   state      // 0 = ordre en attente, 1 = en position
    float entry
    float sl
    float risk
    float tp1
    float tp2
    int   born
    int   entryBar = na
    bool  tp1Hit   = false
    box   zone
    line  mss
    label mssLb
    label swp
    line  eL
    line  sL
    line  t1L
    line  t2L
    label res

method del(Pool p) =>
    line.delete(p.ln)
    label.delete(p.lb)
    p

method wipe(Trade t) =>
    box.delete(t.zone)
    line.delete(t.mss)
    label.delete(t.mssLb)
    label.delete(t.swp)
    line.delete(t.eL)
    line.delete(t.sL)
    line.delete(t.t1L)
    line.delete(t.t2L)
    label.delete(t.res)
    t

var array<Pool>  pools = array.new<Pool>()
var array<Trade> hist  = array.new<Trade>()
var Trade        cur   = na

// Ajoute un niveau de liquidité (remplace l'ancien PDH / PDL / AS ; 2 swings max. par côté)
f_addPool(float px, string nm, int side, bool isSwing, int b) =>
    if pools.size() > 0
        int sameSide = 0
        for i = pools.size() - 1 to 0
            Pool q = pools.get(i)
            bool drop = false
            if not isSwing and q.name == nm
                drop := true
            if isSwing and q.swing and q.side == side
                sameSide += 1
                if sameSide >= 2
                    drop := true
            if drop
                q.del()
                pools.remove(i)
    Pool p = Pool.new(px, nm, side, isSwing)
    if showLiq
        p.ln := line.new(b, px, bar_index, px, color = color.new(neutCol, 40), style = line.style_dotted, width = 1)
        p.lb := label.new(bar_index, px, nm, color = color.new(neutCol, 100), textcolor = neutCol,
             style = label.style_label_left, size = size.tiny)
    pools.push(p)

// Construit la zone d'entrée après un MSS (FVG laissé par le déplacement, ou OB)
// span = nombre de bougies depuis le sweep (0 = rien à faire)
f_zone(int d, int span, float swX) =>
    float zT = na
    float zB = na
    int   zStart = na
    int   fvgOff = -1
    if span >= 2
        for o = 0 to span - 2
            bool gap = d == 1 ? (low[o] > high[o + 2] and high[o + 2] > swX) : (high[o] < low[o + 2] and low[o + 2] < swX)
            if gap
                fvgOff := o
                break
    if fvgOff >= 0
        float fT = d == 1 ? low[fvgOff] : low[fvgOff + 2]
        float fB = d == 1 ? high[fvgOff + 2] : high[fvgOff]
        // OB = dernière bougie opposée avant le déplacement (entre le sweep et le FVG)
        int obOff = span
        for o = fvgOff + 2 to span
            bool opp = d == 1 ? close[o] < open[o] : close[o] > open[o]
            if opp
                obOff := o
                break
        float oT = high[obOff]
        float oB = low[obOff]
        zT := zoneMode == "FVG" ? fT : zoneMode == "Order Block" ? oT : math.max(fT, oT)
        zB := zoneMode == "FVG" ? fB : zoneMode == "Order Block" ? oB : math.min(fB, oB)
        zStart := bar_index - (zoneMode == "FVG" ? fvgOff + 2 : obOff)
    [zT, zB, zStart]

// ═══════════════════════════════════════════════════════════════════════════
// 4. ÉTAT
// ═══════════════════════════════════════════════════════════════════════════
// Sweeps en attente de MSS (bull = liquidité basse prise, bear = liquidité haute prise)
var float  bSwX = na
var int    bSwBar = na
var string bSwNm = ""
var float  sSwX = na
var int    sSwBar = na
var string sSwNm = ""
// Structure interne
var float iHi = na
var int   iHiBar = na
var bool  iHiUsed = true
var float iLo = na
var int   iLoBar = na
var bool  iLoUsed = true
var int   iTrend = 0
// Liquidité : dernier swing (pour EQH / EQL) et range asiatique en construction
var float lastLiqH = na
var float lastLiqL = na
var float aH = na
var float aL = na
var int   aHBar = na
var int   aLBar = na
// Compteurs
var int   dayCount = 0
var int   nTrades = 0
var int   nTp1 = 0
var int   nTp2 = 0
var int   nLoss = 0
var float sumR = 0.0
var string status = "Recherche d'un sweep de liquidité"

// Signaux de la bougie (pour les alertes)
bool setupBull = false
bool setupBear = false
bool entryBull = false
bool entryBear = false
bool tp1Sig    = false
bool slSig     = false
// Déclencheurs calculés en phase A, utilisés en phase B
int    trigBullSpan = 0
int    trigBearSpan = 0
string bullMssTxt = ""
string bearMssTxt = ""

// ═══════════════════════════════════════════════════════════════════════════
// 5. PHASE A (clôture) : liquidité, sweeps, structure interne
// ═══════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed and tfOk
    if newDay
        dayCount := 0

    // ── 5.1 Nouveaux niveaux de liquidité ───────────────────────────────────
    if usePDHL and newDay and not na(pdh)
        f_addPool(pdh, "PDH", 1, false, bar_index)
        f_addPool(pdl, "PDL", -1, false, bar_index)
    if inAsia and not inAsia[1]
        aH    := high
        aL    := low
        aHBar := bar_index
        aLBar := bar_index
    else if inAsia
        if high > aH
            aH    := high
            aHBar := bar_index
        if low < aL
            aL    := low
            aLBar := bar_index
    if useAsia and asiaEnd and not na(aH)
        f_addPool(aH, "AS H", 1, false, aHBar)
        f_addPool(aL, "AS L", -1, false, aLBar)
    if useSwing and not na(liqPH)
        bool eqh = not na(lastLiqH) and math.abs(liqPH - lastLiqH) <= eqTol * atr
        f_addPool(eqh ? math.max(liqPH, lastLiqH) : liqPH, eqh ? "EQH" : "BSL", 1, true, bar_index - liqLen)
        lastLiqH := liqPH
    if useSwing and not na(liqPL)
        bool eql = not na(lastLiqL) and math.abs(liqPL - lastLiqL) <= eqTol * atr
        f_addPool(eql ? math.min(liqPL, lastLiqL) : liqPL, eql ? "EQL" : "SSL", -1, true, bar_index - liqLen)
        lastLiqL := liqPL

    // ── 5.2 Sweeps en attente : mise à jour, annulation, expiration ────────
    if not na(bSwX)
        if close < bSwX or bar_index - bSwBar > sweepWin
            bSwX := na
        else if low < bSwX
            bSwX := low
    if not na(sSwX)
        if close > sSwX or bar_index - sSwBar > sweepWin
            sSwX := na
        else if high > sSwX
            sSwX := high

    // ── 5.3 Prise de liquidité : mèche au-delà, clôture en retour = SWEEP ──
    if pools.size() > 0
        for i = pools.size() - 1 to 0
            Pool p = pools.get(i)
            if p.side == -1 and low < p.price
                if close > p.price
                    bSwX   := na(bSwX) ? low : math.min(bSwX, low)
                    bSwBar := bar_index
                    bSwNm  := p.name
                p.del()
                pools.remove(i)
            else if p.side == 1 and high > p.price
                if close < p.price
                    sSwX   := na(sSwX) ? high : math.max(sSwX, high)
                    sSwBar := bar_index
                    sSwNm  := p.name
                p.del()
                pools.remove(i)
            else
                // niveau intact : on prolonge sa ligne jusqu'à la bougie actuelle
                if showLiq
                    line.set_x2(p.ln, bar_index)
                    label.set_x(p.lb, bar_index)

    // ── 5.4 Structure interne : MSS (CHoCH / BOS) ──────────────────────────
    if not na(iPH)
        iHi     := iPH
        iHiBar  := bar_index - mssLen
        iHiUsed := false
    if not na(iPL)
        iLo     := iPL
        iLoBar  := bar_index - mssLen
        iLoUsed := false
    if not iHiUsed and not na(iHi) and close > iHi
        iHiUsed := true
        bullMssTxt := iTrend == -1 ? "CHoCH" : "BOS"
        iTrend := 1
        if not na(bSwX)
            trigBullSpan := bar_index - bSwBar
    if not iLoUsed and not na(iLo) and close < iLo
        iLoUsed := true
        bearMssTxt := iTrend == 1 ? "CHoCH" : "BOS"
        iTrend := -1
        if not na(sSwX)
            trigBearSpan := bar_index - sSwBar

// Zones (appel à chaque bougie ; ne calcule que s'il y a un déclencheur)
[bzT, bzB, bzStart] = f_zone(1, trigBullSpan, bSwX)
[szT, szB, szStart] = f_zone(-1, trigBearSpan, sSwX)

// ═══════════════════════════════════════════════════════════════════════════
// 6. PHASE B (clôture) : création du setup, entrée, gestion, statistiques
// ═══════════════════════════════════════════════════════════════════════════
// Termine un trade : résultat en R, marque, historique, nettoyage
f_close(Trade t, float r, string txt, color c, float y) =>
    t.res := label.new(bar_index, y, txt, color = color.new(c, 100), textcolor = c,
         style = t.d == 1 ? label.style_label_down : label.style_label_up, size = size.small)
    for ln in array.from(t.eL, t.sL, t.t1L, t.t2L)
        line.set_x2(ln, bar_index)
    box.set_right(t.zone, bar_index)
    hist.push(t)
    while hist.size() > keepT
        hist.shift().wipe()
    r

// Crée un setup (ordre en attente) après un MSS valide
f_setup(int d, float zT, float zB, int zStart, float swX, int swBar, string swNm, float mssPx, int mssBar, string mssTxt) =>
    Trade t = na
    if not na(zT)
        float entry = entryMode == "Milieu (CE)" ? (zT + zB) / 2 : (d == 1 ? zT : zB)
        float sl    = d == 1 ? swX - slBuf * atr : swX + slBuf * atr
        float risk  = math.abs(entry - sl)
        bool  side  = d == 1 ? (entry < close and entry > sl) : (entry > close and entry < sl)
        // Liquidité opposée la plus proche = objectif TP2
        float tgt = na
        if pools.size() > 0
            for q in pools
                bool ahead = d == 1 ? (q.side == 1 and q.price > entry) : (q.side == -1 and q.price < entry)
                if ahead and (na(tgt) or math.abs(q.price - entry) < math.abs(tgt - entry))
                    tgt := q.price
        bool room = na(tgt) or math.abs(tgt - entry) >= minRoom * risk
        if risk > 0 and side and room and f_biasOk(d) and f_pdOk(d, entry)
            color col = d == 1 ? bullCol : bearCol
            t := Trade.new(d = d, state = 0, entry = entry, sl = sl, risk = risk,
                 tp1 = entry + d * tp1R * risk, tp2 = na(tgt) ? entry + d * fallbackR * risk : tgt, born = bar_index)
            t.zone  := box.new(zStart, zT, bar_index + entryExp, zB, border_color = color.new(col, 60), border_width = 1,
                 bgcolor = color.new(col, transpIn), text = zoneMode == "Order Block" ? "OB" : "FVG", text_size = size.small,
                 text_color = color.new(col, 20), text_halign = text.align_left, text_valign = text.align_center)
            t.mss   := line.new(mssBar, mssPx, bar_index, mssPx, color = neutCol, style = line.style_dashed, width = 1)
            t.mssLb := label.new(int((mssBar + bar_index) / 2), mssPx, mssTxt, color = color.new(neutCol, 100),
                 textcolor = col, style = d == 1 ? label.style_label_down : label.style_label_up, size = size.small)
            t.swp   := label.new(swBar, swX, "✕ " + swNm, color = color.new(neutCol, 100), textcolor = neutCol,
                 style = d == 1 ? label.style_label_up : label.style_label_down, size = size.tiny)
    t

if barstate.isconfirmed and tfOk
    // ── 6.1 Nouveau setup (sauf si un trade est déjà en position) ──────────
    bool busy = not na(cur) and cur.state == 1
    if not busy and trigBullSpan > 0
        Trade t = f_setup(1, bzT, bzB, bzStart, bSwX, bSwBar, bSwNm, iHi, iHiBar, bullMssTxt)
        if not na(t)
            if not na(cur)
                cur.wipe()
            cur := t
            setupBull := true
        bSwX := na
    if not busy and trigBearSpan > 0
        Trade t = f_setup(-1, szT, szB, szStart, sSwX, sSwBar, sSwNm, iLo, iLoBar, bearMssTxt)
        if not na(t)
            if not na(cur)
                cur.wipe()
            cur := t
            setupBear := true
        sSwX := na

    // ── 6.2 Ordre en attente : entrée, expiration, annulation ──────────────
    if not na(cur) and cur.state == 0 and bar_index > cur.born
        bool cancel = false
        if bar_index - cur.born > entryExp
            cancel := true
        else if f_adv(cur.d, cur.entry)
            if kzOk and dayCount < maxDay
                // Entrée (ordre limite touché)
                cur.state    := 1
                cur.entryBar := bar_index
                dayCount     += 1
                nTrades      += 1
                color col = cur.d == 1 ? bullCol : bearCol
                cur.eL  := line.new(bar_index, cur.entry, bar_index, cur.entry, color = neutCol, width = 1)
                cur.sL  := line.new(bar_index, cur.sl, bar_index, cur.sl, color = bearCol, style = line.style_dashed, width = 1)
                cur.t1L := line.new(bar_index, cur.tp1, bar_index, cur.tp1, color = bullCol, style = line.style_dotted, width = 1)
                cur.t2L := line.new(bar_index, cur.tp2, bar_index, cur.tp2, color = bullCol, style = line.style_dashed, width = 1)
                box.set_right(cur.zone, bar_index)
                if cur.d == 1
                    entryBull := true
                else
                    entryBear := true
                // Stop touché sur la bougie d'entrée : compté perdant (hypothèse prudente)
                if f_adv(cur.d, cur.sl)
                    nLoss += 1
                    sumR  -= 1.0
                    slSig := true
                    f_close(cur, -1.0, "✕ −1R", bearCol, cur.d == 1 ? low : high)
                    cur := na
            else
                cancel := true      // touché hors killzone ou quota du jour atteint
        else if f_fav(cur.d, cur.tp1) or f_adv(cur.d, cur.sl)
            cancel := true          // parti sans nous, ou setup invalidé
        if cancel and not na(cur)
            cur.wipe()
            cur := na

    // ── 6.3 Position : TP1 (partiel + stop à l'entrée), TP2, stop ──────────
    else if not na(cur) and cur.state == 1 and bar_index > cur.entryBar
        for ln in array.from(cur.eL, cur.sL, cur.t1L, cur.t2L)
            line.set_x2(ln, bar_index)
        float part = partPct / 100.0
        float rr2  = math.abs(cur.tp2 - cur.entry) / cur.risk
        if not cur.tp1Hit
            if f_adv(cur.d, cur.sl)
                nLoss += 1
                sumR  -= 1.0
                slSig := true
                f_close(cur, -1.0, "✕ −1R", bearCol, cur.d == 1 ? low : high)
                cur := na
            else if f_fav(cur.d, cur.tp1)
                cur.tp1Hit := true
                nTp1 += 1
                tp1Sig := true
                cur.sl := cur.entry            // stop au prix d'entrée
                line.set_y1(cur.sL, cur.entry)
                line.set_y2(cur.sL, cur.entry)
        else
            if f_fav(cur.d, cur.tp2)
                nTp2 += 1
                float r = part * tp1R + (1 - part) * rr2
                sumR += r
                f_close(cur, r, "✓ +" + str.tostring(r, "#.#") + "R", bullCol, cur.d == 1 ? high : low)
                cur := na
            else if f_adv(cur.d, cur.entry)
                float r = part * tp1R
                sumR += r
                f_close(cur, r, "✓ +" + str.tostring(r, "#.#") + "R", bullCol, cur.d == 1 ? high : low)
                cur := na

    // ── 6.4 Texte d'état pour le panneau ────────────────────────────────────
    status := not na(cur) and cur.state == 1 ? (cur.d == 1 ? "En position ACHAT" : "En position VENTE") + (cur.tp1Hit ? " (TP1 pris)" : "") :
         not na(cur) ? "Ordre en attente dans le " + (zoneMode == "Order Block" ? "OB" : "FVG") :
         not na(bSwX) ? "Sweep " + bSwNm + " → attente MSS haussier" :
         not na(sSwX) ? "Sweep " + sSwNm + " → attente MSS baissier" : "Recherche d'un sweep de liquidité"

// ═══════════════════════════════════════════════════════════════════════════
// 7. SIGNAUX, PANNEAU, ALERTES
// ═══════════════════════════════════════════════════════════════════════════
plotshape(entryBull, "Entrée achat", shape.triangleup, location.belowbar, bullCol, size = size.small)
plotshape(entryBear, "Entrée vente", shape.triangledown, location.abovebar, bearCol, size = size.small)

var table panel = table.new(position.top_right, 1, 6)
if showPanel and barstate.islast
    string biasTxt = not htfValid ? "Biais : TF HTF invalide" : "Biais " + htfTf + " : " + (htfT == 1 ? "▲ haussier" : htfT == -1 ? "▼ baissier" : "– indéfini")
    color  biasCol = htfT == 1 and htfValid ? bullCol : htfT == -1 and htfValid ? bearCol : neutCol
    string pdTxt   = na(eqPx) or not htfValid ? "Premium / discount : –" : close < eqPx ? "Prix en DISCOUNT (achats)" : "Prix en PREMIUM (ventes)"
    string kzTxt   = not tfOk ? "Timeframe trop grand (max " + maxTf + ")" : inLon ? "Killzone LONDRES" : inNy ? "Killzone NEW YORK" : "Hors killzone"
    int    closed  = nTp1 + nLoss
    string st1     = "Trades " + str.tostring(nTrades) + " · TP1 " + (closed > 0 ? str.tostring(100.0 * nTp1 / closed, "#") + " %" : "–") +
         " · TP2 " + (closed > 0 ? str.tostring(100.0 * nTp2 / closed, "#") + " %" : "–")
    float  expR    = closed > 0 ? sumR / closed : 0.0
    string st2     = "Résultat " + (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.#") + "R · Espérance " +
         (closed > 0 ? (expR >= 0 ? "+" : "") + str.tostring(expR, "#.##") + "R/trade" : "–")
    table.cell(panel, 0, 0, biasTxt, text_color = biasCol, text_size = size.small, text_halign = text.align_right)
    table.cell(panel, 0, 1, pdTxt, text_color = neutCol, text_size = size.small, text_halign = text.align_right)
    table.cell(panel, 0, 2, kzTxt, text_color = inLon or inNy ? bullCol : neutCol, text_size = size.small, text_halign = text.align_right)
    table.cell(panel, 0, 3, status, text_color = neutCol, text_size = size.small, text_halign = text.align_right)
    table.cell(panel, 0, 4, st1, text_color = neutCol, text_size = size.small, text_halign = text.align_right)
    table.cell(panel, 0, 5, st2, text_color = sumR >= 0 ? bullCol : bearCol, text_size = size.small, text_halign = text.align_right)

alertcondition(setupBull, "Koss Pro - Setup achat", "Koss Pro : sweep + MSS haussier, ordre en attente sur {{ticker}}")
alertcondition(setupBear, "Koss Pro - Setup vente", "Koss Pro : sweep + MSS baissier, ordre en attente sur {{ticker}}")
alertcondition(entryBull, "Koss Pro - Entrée achat", "Koss Pro : ENTRÉE ACHAT sur {{ticker}} ({{close}})")
alertcondition(entryBear, "Koss Pro - Entrée vente", "Koss Pro : ENTRÉE VENTE sur {{ticker}} ({{close}})")
alertcondition(tp1Sig, "Koss Pro - TP1 atteint", "Koss Pro : TP1 atteint sur {{ticker}}, stop à l'entrée")
alertcondition(slSig, "Koss Pro - Stop touché", "Koss Pro : stop touché sur {{ticker}}")
