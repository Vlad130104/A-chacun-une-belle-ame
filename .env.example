# Empreinte scrypt du mot de passe d'accès. Génère-la avec : npm run hash-password -- "ton mot de passe"
ACCESS_PASSWORD_HASH=
# Secret de signature des sessions (48 octets aléatoires). Génère-le avec : npm run new-secret
# Le changer déconnecte immédiatement tout le monde.
SESSION_SECRET=
# Facultatif : clé API Anthropic. Ajuste le script à la durée choisie (1 min à 2 h). Sans elle, la durée suit le texte.
ANTHROPIC_API_KEY=
# Facultatif : clé API Pexels (gratuite) pour les vidéos réalistes modernes. https://www.pexels.com/api/
PEXELS_API_KEY=
# Facultatif : voix ElevenLabs (clé du compte, payant au caractère)
ELEVENLABS_API_KEY=
# Facultatif : clé API Pixabay (gratuite), deuxième banque de vidéos. https://pixabay.com/api/docs/
PIXABAY_API_KEY=
