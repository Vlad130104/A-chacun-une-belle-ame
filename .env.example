# Empreinte scrypt du mot de passe d'accès. Génère-la avec : npm run hash-password -- "ton mot de passe"
ACCESS_PASSWORD_HASH=
# Secret de signature des sessions (48 octets aléatoires). Génère-le avec : npm run new-secret
# Le changer déconnecte immédiatement tout le monde.
SESSION_SECRET=
# Facultatif : clé API Anthropic pour la mise en forme par Claude. Sans elle, le découpage reste automatique.
ANTHROPIC_API_KEY=
# Facultatif : clé API Pexels (gratuite) pour les B-rolls automatiques. https://www.pexels.com/api/
PEXELS_API_KEY=
