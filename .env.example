# ─────────────────────────────────────────────────────────────────────────────
# « À Chacun Une Belle Âme » — configuration
#
# AUCUNE VALEUR RÉELLE DANS CE FICHIER. Il est versionné et sert de documentation.
# Copiez-le en .env et remplissez localement. Les secrets de production vivent
# dans un gestionnaire de secrets, jamais ici. Voir SECURITY.md §7.
#
# Toute variable est validée au démarrage par un schéma Zod : une valeur
# manquante, mal typée ou hors bornes empêche le démarrage de l'application.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Base de données ──────────────────────────────────────────────────────────
# Le rôle applicatif n'a AUCUN droit sur le schéma `kyc` (ADR-004).
DATABASE_URL=postgresql://acuba:acuba_local_dev@localhost:5432/acuba?schema=app
# Rôle distinct, utilisé uniquement par le module `verification`.
KYC_DATABASE_URL=postgresql://acuba_kyc:acuba_kyc_local_dev@localhost:5432/acuba?schema=kyc

# ── Redis (cache, files BullMQ, présence, rate limiting) ─────────────────────
REDIS_URL=redis://localhost:6379

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
# api | worker | all  (même image, deux rôles — voir 10-plan-de-deploiement.md §3)
PROCESS_ROLE=all

# ── Jetons ───────────────────────────────────────────────────────────────────
# Paire RSA au format PEM, sur une seule ligne avec des \n littéraux.
# Génération locale : node scripts/generate-keys.mjs
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=8

# ── Chiffrement et hachage ───────────────────────────────────────────────────
# 32 octets en base64. ENCRYPTION_KEY_PREVIOUS sert à la rotation de clé.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=
HASH_SALT=
# Secret du pseudonyme analytique (ADR-021). DOIT être différent de HASH_SALT :
# les pseudonymes partent vers des outils de visualisation, le sel des empreintes
# recherchables jamais. Le démarrage échoue si les deux valeurs sont identiques.
ANALYTICS_HMAC_SECRET=

# ── Stockage compatible S3 ───────────────────────────────────────────────────
# DEUX buckets séparés, avec des identifiants distincts (ADR-004).
# `memory` conserve les objets dans le processus : développement hors ligne et
# tests uniquement. Une pièce d'identité déposée est perdue au redémarrage, donc
# NODE_ENV=production refuse de démarrer avec cette valeur (story E-06).
STORAGE_PROVIDER=memory
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_FORCE_PATH_STYLE=true
S3_MEDIA_BUCKET=acuba-media
# DEUX comptes de service distincts, jamais le même (ADR-004) : qui détient les
# clés du bucket média ne doit pas pouvoir lire les pièces d'identité. Le
# démarrage échoue si les deux clés d'accès sont identiques.
S3_MEDIA_ACCESS_KEY=
S3_MEDIA_SECRET_KEY=
S3_KYC_BUCKET=acuba-kyc
S3_KYC_ACCESS_KEY=
S3_KYC_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=300
KYC_SIGNED_URL_TTL_SECONDS=300

# ── Ports externes ───────────────────────────────────────────────────────────
# `mock` / `console` = implémentation simulée. Voir docs/MOCKS.md.
# En production, un port critique simulé EMPÊCHE le démarrage.
SMS_PROVIDER=console
KYC_PROVIDER=mock
PAYMENT_PROVIDER=mock
PUSH_PROVIDER=mock
MAIL_PROVIDER=smtp
CONTENT_MODERATION_PROVIDER=rules
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# SMTP local (Mailpit). En production : service transactionnel réel.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ne-pas-repondre@example.invalid

# Renseigné uniquement lorsqu'un prestataire est contractualisé.
SMS_API_KEY=
SMS_SENDER_ID=
KYC_API_KEY=
KYC_WEBHOOK_SECRET=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PUSH_SERVICE_ACCOUNT_JSON=

# ── Règles métier (configurables — voir 03-modele-de-donnees.md §11) ─────────
MINIMUM_AGE=18
KYC_DOCUMENT_RETENTION_DAYS=90
MESSAGE_RETENTION_MONTHS=24
ACCOUNT_DELETION_GRACE_DAYS=30
ANALYTICS_RETENTION_MONTHS=14
WEBHOOK_RETENTION_DAYS=90
PHOTO_SOFT_DELETE_DAYS=7

DAILY_SUGGESTION_LIMIT_FREE=10
DAILY_SUGGESTION_LIMIT_PREMIUM=30
DAILY_LIKE_LIMIT_FREE=10
DAILY_LIKE_LIMIT_PREMIUM=50
MIN_COMPLETION_TO_PUBLISH=60
MAX_PHOTOS=6
MIN_PHOTOS_TO_PUBLISH=3
MAX_UPLOAD_SIZE_BYTES=8388608
MAX_KYC_UPLOAD_SIZE_BYTES=10485760
UNANSWERED_MESSAGE_LIMIT=20
MATCHING_MAX_CANDIDATES=500
# HETERO | OPEN — politique de mise en relation (ADR-019, question Q7)
MATCHING_POLICY=HETERO

# ── Sécurité ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_HOUR=10
RATE_LIMIT_OTP_PER_10_MIN=3
OTP_MAX_ATTEMPTS=5
OTP_TTL_SECONDS=300

# ── Frontends ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── Observabilité ────────────────────────────────────────────────────────────
# Laisser vide en local : aucun événement n'est alors émis vers l'extérieur.
ERROR_TRACKING_DSN=
METRICS_ENABLED=false
